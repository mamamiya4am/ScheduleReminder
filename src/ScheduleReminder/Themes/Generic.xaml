<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:ScheduleReminder.Controls">

    <!-- IconView 默认样式：线宽固定 1.5、端点与连接统一圆角。
         采用 Path + Stretch=Uniform（与改造前的写法一致），
         几何按 24×24 设计坐标缩放到 IconSize，线宽保持设备像素 1.5 不随缩放变细。
         描边默认跟随主题线条色，实例可用 IconStroke 覆盖（标题栏绑按钮 Foreground）。 -->
    <Style TargetType="{x:Type controls:IconView}">
        <Setter Property="IconSize" Value="16" />
        <Setter Property="IconStroke" Value="{DynamicResource IconStrokeBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:IconView}">
                    <Path Data="{TemplateBinding Glyph}"
                          Stroke="{TemplateBinding IconStroke}"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Stretch="Uniform"
                          Width="{TemplateBinding IconSize}"
                          Height="{TemplateBinding IconSize}"
                          SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
