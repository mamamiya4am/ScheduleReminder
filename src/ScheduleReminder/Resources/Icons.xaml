<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 图标线条色：由 ThemeService 跟随「边框色」设置统一写入（见 ADR-009），此处仅为默认值 -->
    <SolidColorBrush x:Key="IconStrokeBrush" Color="#F2F2F2" />

    <!-- 关闭 -->
    <Geometry x:Key="IconClose">M18 6 6 18 M6 6 18 18</Geometry>

    <!-- 打开目录（文件夹） -->
    <Geometry x:Key="IconFolder">M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z</Geometry>

    <!-- 编辑（方框铅笔） -->
    <Geometry x:Key="IconSquarePen">M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7 M18.375 2.625a2.121 2.121 0 1 1 3 3L12 15l-4 1 1-4Z</Geometry>

    <!-- 删除（垃圾桶） -->
    <Geometry x:Key="IconTrash">M3 6h18 M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6 m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2 M10 11v6 M14 11v6</Geometry>

    <!-- 日历 -->
    <Geometry x:Key="IconCalendar">M3 4h18v18H3z M8 2v4 M16 2v4 M3 10h18</Geometry>

    <!-- 统计数据：左侧纵轴 + 三段上升折线（统计数据.svg） -->
    <Geometry x:Key="IconChart">M3 3v18h18 M6.5 15.5 10.5 10.5 14 13 20 6</Geometry>

    <!-- 时钟（时间按钮；手册未列，为统一矢量风格补入） -->
    <Geometry x:Key="IconClock">M12 2A10 10 0 1 0 12 22A10 10 0 1 0 12 2 M12 6L12 12L16 14</Geometry>

    <!-- 设置（齿轮） -->
    <Geometry x:Key="IconSettings">M21.598 15.468A10.2 10.2 0 0 1 19.802 18.578A0.5 0.5 0 0 1 19.266 18.716L16.752 17.842A0.5 0.5 0 0 0 16.28 17.92A7.3 7.3 0 0 1 14.987 18.666A0.5 0.5 0 0 0 14.683 19.036L14.183 21.651A0.5 0.5 0 0 1 13.796 22.046A10.2 10.2 0 0 1 10.204 22.046A0.5 0.5 0 0 1 9.817 21.651L9.317 19.036A0.5 0.5 0 0 0 9.013 18.666A7.3 7.3 0 0 1 7.72 17.92A0.5 0.5 0 0 0 7.248 17.842L4.734 18.716A0.5 0.5 0 0 1 4.198 18.578A10.2 10.2 0 0 1 2.402 15.468A0.5 0.5 0 0 1 2.55 14.935L4.565 13.194A0.5 0.5 0 0 0 4.733 12.746A7.3 7.3 0 0 1 4.733 11.254A0.5 0.5 0 0 0 4.565 10.806L2.55 9.065A0.5 0.5 0 0 1 2.402 8.532A10.2 10.2 0 0 1 4.198 5.422A0.5 0.5 0 0 1 4.734 5.284L7.248 6.158A0.5 0.5 0 0 0 7.72 6.08A7.3 7.3 0 0 1 9.013 5.334A0.5 0.5 0 0 0 9.317 4.964L9.817 2.349A0.5 0.5 0 0 1 10.204 1.954A10.2 10.2 0 0 1 13.796 1.954A0.5 0.5 0 0 1 14.183 2.349L14.683 4.964A0.5 0.5 0 0 0 14.987 5.334A7.3 7.3 0 0 1 16.28 6.08A0.5 0.5 0 0 0 16.752 6.158L19.266 5.284A0.5 0.5 0 0 1 19.802 5.422A10.2 10.2 0 0 1 21.598 8.532A0.5 0.5 0 0 1 21.45 9.065L19.435 10.806A0.5 0.5 0 0 0 19.267 11.254A7.3 7.3 0 0 1 19.267 12.746A0.5 0.5 0 0 0 19.435 13.194L21.45 14.935A0.5 0.5 0 0 1 21.598 15.468Z M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z</Geometry>

    <!-- 最大化（方块） -->
    <Geometry x:Key="IconMaximize">M4 4h16v16H4z</Geometry>

    <!-- 还原（前后叠方块） -->
    <Geometry x:Key="IconRestore">M4 8h12v12H4z M8 4h12v12</Geometry>

    <!-- 最小化（单横线） -->
    <Geometry x:Key="IconMinimize">M5 12h14</Geometry>

    <!-- 新建日程（日历加号） -->
    <Geometry x:Key="IconCalendarPlus">M16 19h6 M16 2v4 M19 16v6 M21 12.598V6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h8.5 M3 10h18 M8 2v4</Geometry>

    <!-- 闹钟（lucide alarm-clock 风格；用 Ellipse 避免弧线 Path 失真） -->
    <GeometryGroup x:Key="IconAlarm">
        <EllipseGeometry Center="12,13" RadiusX="8" RadiusY="8" />
        <PathGeometry Figures="M12 9v4l2.5 2.5 M5 3 2 6 M22 6l-3-3 M6.6 19.4 4 22 M20 22l-2.6-2.6" />
    </GeometryGroup>

    <!-- 旗帜（三角旗） -->
    <Geometry x:Key="IconFlag">M7 4v17 M7 5l11 5-11 5z</Geometry>

    <!-- 刷新（24×24 设计坐标；由 refresh.svg 转换为 WPF 绝对坐标路径） -->
    <Geometry x:Key="IconRefresh">M3 12 A9 9 0 0 1 12 3 A9.75 9.75 0 0 1 18.74 5.74 L21 8 M21 3 L21 8 L16 8 M21 12 A9 9 0 0 1 12 21 A9.75 9.75 0 0 1 5.26 18.26 L3 16 M8 16 L3 16 L3 21</Geometry>

    <!-- 搜索（24×24 设计坐标） -->
    <Geometry x:Key="IconSearch">M10.5 17 A6.5 6.5 0 1 1 10.5 4 A6.5 6.5 0 1 1 10.5 17 M15.6 15.6 L20 20</Geometry>

    <!-- 右侧栏：展开态（外框 + 内侧细竖线） -->
    <GeometryGroup x:Key="IconPanelExpand">
        <RectangleGeometry Rect="1.5,2.5,13,11" RadiusX="2" RadiusY="2" />
        <LineGeometry StartPoint="9.75,4.25" EndPoint="9.75,11.75" />
    </GeometryGroup>

    <!-- 右侧栏：收起态（外框 + 右缘粗竖线） -->
    <GeometryGroup x:Key="IconPanelCollapse">
        <RectangleGeometry Rect="1.5,2.5,13,11" RadiusX="2" RadiusY="2" />
        <LineGeometry StartPoint="11.5,4.25" EndPoint="11.5,11.75" />
    </GeometryGroup>

    <!-- 月视图 → 周视图（icon-loose-layout.svg：24×24，stroke-width=2，rx=2）
         外框 x=3 y=4.5 w=18 h=15；竖线 x=9、15，y=4.5→19.5 -->
    <GeometryGroup x:Key="IconLooseLayout">
        <RectangleGeometry Rect="3,4.5,18,15" RadiusX="2" RadiusY="2" />
        <LineGeometry StartPoint="9,4.5" EndPoint="9,19.5" />
        <LineGeometry StartPoint="15,4.5" EndPoint="15,19.5" />
    </GeometryGroup>

    <!-- 周视图 → 月视图（icon-month-layout.svg：24×24，stroke-width=2，rx=2）
         外框 x=3 y=4.5 w=18 h=15；横线 y=9.5、14.5；竖线 x=9、15 -->
    <GeometryGroup x:Key="IconMonthLayout">
        <RectangleGeometry Rect="3,4.5,18,15" RadiusX="2" RadiusY="2" />
        <LineGeometry StartPoint="3,9.5" EndPoint="21,9.5" />
        <LineGeometry StartPoint="3,14.5" EndPoint="21,14.5" />
        <LineGeometry StartPoint="9,4.5" EndPoint="9,19.5" />
        <LineGeometry StartPoint="15,4.5" EndPoint="15,19.5" />
    </GeometryGroup>

</ResourceDictionary>
