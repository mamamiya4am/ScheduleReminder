<UserControl x:Class="ScheduleReminder.Views.ToolBoxFlyout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" Width="0" Height="0">

    <UserControl.Resources>
        <!-- 四个图标逐点取自 Project\日历\ 下的 计算器.svg、单位换算.svg、秒表.svg、世界时钟.svg：
             同为 24×24 坐标系、线宽 2、圆头圆角，Viewbox 缩到 16×16 后与 SVG 逐像素重合。
             计算器里的圆点在 SVG 是 r=1 实心圆，这里写成 h0.01 加圆头线帽，描边直径正好 2，视觉相同。 -->
        <Geometry x:Key="IconToolCalculator">M7 3 H17 A2 2 0 0 1 19 5 V19 A2 2 0 0 1 17 21 H7 A2 2 0 0 1 5 19 V5 A2 2 0 0 1 7 3 Z M8 7 H16 M9 12 h0.01 M15 12 h0.01 M9 16 h0.01 M15 16 h0.01</Geometry>
        <Geometry x:Key="IconToolUnitConverter">M3 8 H16 M13 5 L17 8 L13 11 M21 16 H8 M11 13 L7 16 L11 19</Geometry>
        <Geometry x:Key="IconToolStopwatch">M12 6 A7 7 0 1 1 12 20 A7 7 0 1 1 12 6 M12 13 V9 M12 2 V5 M9 2 H15</Geometry>
        <Geometry x:Key="IconToolWorldClock">M12 3 A9 9 0 1 1 12 21 A9 9 0 1 1 12 3 M12 3 C7 7 7 17 12 21 M12 3 C17 7 17 17 12 21 M3 12 H21</Geometry>

        <!-- 一格：图标在上、名称在下；悬停与按下用全局底色画刷，不新造色值 -->
        <Style x:Key="ToolTileStyle" TargetType="Button">
            <Setter Property="Height" Value="58" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgBtnBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- 面板：左上角与工具图标重合，盖住按钮本身；点面板外自动关闭 -->
        <Popup x:Name="Host" Placement="Relative" HorizontalOffset="0" VerticalOffset="0"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
               Opened="OnPopupOpened" Closed="OnPopupClosed">
            <Border x:Name="PanelRoot" Width="190" Padding="8"
                    Focusable="True" PreviewKeyDown="OnPanelKeyDown"
                    LostKeyboardFocus="OnPanelLostKeyboardFocus"
                    MouseLeave="OnPanelMouseLeave"
                    Background="{DynamicResource PopupBgBrush}"
                    BorderBrush="{DynamicResource BorderWeakBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusWindow}">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="18" BlurRadius="60" Color="Black" Opacity="0.55" />
                </Border.Effect>
                <StackPanel>
                    <ItemsControl x:Name="ToolList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ToolTileStyle}"
                                        Tag="{Binding Id}" ToolTip="{Binding DisplayName}"
                                        Click="OnToolClick">
                                    <StackPanel>
                                        <Viewbox Width="16" Height="16" Stretch="Uniform">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="{Binding Icon}"
                                                      Stroke="{DynamicResource IconStrokeBrush}"
                                                      StrokeThickness="2"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round" />
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="{Binding DisplayName}" Margin="0,6,0,0"
                                                   HorizontalAlignment="Center"
                                                   FontFamily="{DynamicResource AppFont}"
                                                   FontSize="{DynamicResource FontBodyS}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
