<Window x:Class="ScheduleReminder.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="系统设置"
        Width="520" Height="620" MinWidth="480" MinHeight="520"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        Background="Transparent" ShowInTaskbar="False" UseLayoutRounding="True">
    <Border CornerRadius="{DynamicResource RadiusWindow}"
            Background="{DynamicResource WindowBgBrush}"
            BorderBrush="{DynamicResource BorderWeakBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="*" />
                <RowDefinition Height="52" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="系统设置" Margin="14,0,0,0" VerticalAlignment="Center"
                               FontSize="{DynamicResource FontBody}"
                               FontFamily="{DynamicResource AppFont}"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <Button HorizontalAlignment="Right" Margin="0,0,6,0"
                            Style="{StaticResource TitleBarCloseButtonStyle}" Click="OnCloseClick">
                        <Path Data="{StaticResource IconClose}"
                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                              StrokeThickness="1.5" Stretch="Uniform"
                              Width="13" Height="13" SnapsToDevicePixels="True" />
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="18,0,18,8">

                    <!-- ===== 外观 ===== -->
                    <Rectangle Style="{StaticResource GroupSeparatorStyle}" />
                    <TextBlock Text="外观" Style="{StaticResource GroupTitleStyle}" />
                    <!-- ===== 界面缩放 ===== -->
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="界面大小" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox x:Name="ScaleCombo" Grid.Column="1" Height="26" Margin="0,0,8,0"
                                  Style="{StaticResource ComboStyle}" DropDownClosed="OnScaleChanged">
                            <ComboBoxItem Content="极小（80%）" Tag="80" />
                            <ComboBoxItem Content="小（90%）" Tag="90" />
                            <ComboBoxItem Content="中（100%）" Tag="100" />
                            <ComboBoxItem Content="大（110%）" Tag="110" />
                            <ComboBoxItem Content="巨大（120%）" Tag="120" />
                        </ComboBox>
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <!-- ===== 系统文字颜色 ===== -->
                        <Grid.ColumnDefinitions>                            
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>                        
                        <TextBlock Grid.Column="0" Text="系统文字颜色" Style="{StaticResource FieldLabelStyle}" />
                        <Button x:Name="TextSwatch" Grid.Column="1" Height="26" Margin="0,0,8,0"
                                Style="{StaticResource NormalButtonStyle}" Click="OnPickTextColor">
                            <Rectangle x:Name="TextRect" Width="100" Height="14" />
                        </Button>
                        <Button Grid.Column="2" Content="恢复默认" Width="80" Height="26"
                                HorizontalAlignment="Right"
                                Style="{StaticResource NormalButtonStyle}" Click="OnResetTextColor" />
                    </Grid>
                    <!-- ===== 系统边框颜色 ===== -->
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>                        
                        <TextBlock Grid.Column="0" Text="系统边框颜色" Style="{StaticResource FieldLabelStyle}" />
                        <Button x:Name="BorderSwatch" Grid.Column="1" Height="26" Margin="0,0,8,0"
                                Style="{StaticResource NormalButtonStyle}" Click="OnPickBorderColor">
                            <Rectangle x:Name="BorderRect" Width="100" Height="14" />
                        </Button>
                        <Button Grid.Column="2" Content="恢复默认" Width="80" Height="26"
                                HorizontalAlignment="Right"
                                Style="{StaticResource NormalButtonStyle}" Click="OnResetBorderColor" />
                    </Grid>
                    <!-- ===== 系统边框颜色 ===== -->
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="今日高亮显色" Style="{StaticResource FieldLabelStyle}" />
                        <Button x:Name="TodaySwatch" Grid.Column="1" Height="26" Margin="0,0,8,0"
                                Style="{StaticResource NormalButtonStyle}" Click="OnPickTodayColor">
                            <Rectangle x:Name="TodayRect" Width="100" Height="14" />
                        </Button>
                        <Button Grid.Column="2" Content="恢复默认" Width="80" Height="26"
                                HorizontalAlignment="Right"
                                Style="{StaticResource NormalButtonStyle}" Click="OnResetTodayColor" />
                    </Grid>
                    <!-- 焦点边框颜色 -->
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="焦点边框颜色" Style="{StaticResource FieldLabelStyle}" />
                        <Button x:Name="FocusSwatch" Grid.Column="1" Height="26" Margin="0,0,8,0"
                                Style="{StaticResource NormalButtonStyle}" Click="OnPickFocusColor">
                            <Rectangle x:Name="FocusRect" Width="100" Height="14" />
                        </Button>
                        <Button Grid.Column="2" Content="恢复默认" Width="80" Height="26"
                                HorizontalAlignment="Right"
                                Style="{StaticResource NormalButtonStyle}" Click="OnResetFocusColor" />
                    </Grid>
                    <!-- 控件填充色 -->
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="控件填充色" Style="{StaticResource FieldLabelStyle}" />
                        <Button x:Name="ControlFillSwatch" Grid.Column="1" Height="26" Margin="0,0,8,0"
                                Style="{StaticResource NormalButtonStyle}" Click="OnPickControlFillColor">
                            <Rectangle x:Name="ControlFillRect" Width="100" Height="14" />
                        </Button>
                        <Button Grid.Column="2" Content="恢复默认" Width="80" Height="26"
                                HorizontalAlignment="Right"
                                Style="{StaticResource NormalButtonStyle}" Click="OnResetControlFillColor" />
                    </Grid>
                    
                    <!-- ===== 背景 ===== -->
                    <Rectangle Style="{StaticResource GroupSeparatorStyle}" />
                    <TextBlock Text="背景" Style="{StaticResource GroupTitleStyle}" />
                    <!-- ===== 背景颜色 ===== -->
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="背景颜色" Style="{StaticResource FieldLabelStyle}" />
                        <Button x:Name="WindowBgSwatch" Grid.Column="1" Height="26" Margin="0,0,8,0"
                               Style="{StaticResource NormalButtonStyle}" Click="OnPickWindowBgColor">
                            <Rectangle x:Name="WindowBgRect" Width="100" Height="14" />
                        </Button>
                        <Button Grid.Column="2" Content="恢复默认" Width="80" Height="26"
                               HorizontalAlignment="Right"
                               Style="{StaticResource NormalButtonStyle}" Click="OnResetWindowBgColor" />
                    </Grid>
                    <!-- ===== 背景图片 ===== -->
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="175" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="背景图片" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="ImagePathBox" Grid.Column="1" Height="26" Margin="0,0,8,0"
                                 Style="{StaticResource InputBoxStyle}" IsReadOnly="True" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="浏览" Width="70" Height="26" Margin="0,0,6,0"
                                Style="{StaticResource NormalButtonStyle}" Click="OnBrowseImage" />
                            <Button Content="无背景" Width="70" Height="26"
                                Style="{StaticResource NormalButtonStyle}" Click="OnClearBgImageClick" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="显示方式" Style="{StaticResource FieldLabelStyle}" />
                        <!-- 用 DropDownClosed 而不是 SelectionChanged：只有"用户打开下拉并选定"才写设置，
                             初始化时的选中不会触发，从事件源头上杜绝把档位改回去 -->
                        <ComboBox x:Name="StretchCombo" Grid.Column="1" Height="26" Margin="0,0,8,0"
                                  Style="{StaticResource ComboStyle}" DropDownClosed="OnStretchChanged">
                            <ComboBoxItem Content="填充裁剪" Tag="UniformToFill" IsSelected="True" />
                            <ComboBoxItem Content="拉伸填满" Tag="Fill" />                            
                        </ComboBox>
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="背景透明度" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="OpacityBox" Grid.Column="1" Height="26"  Margin="0,0,8,0"
                                 Style="{StaticResource InputBoxStyle}"
                                 PreviewTextInput="OnNumericPreviewTextInput"
                                 DataObject.Pasting="OnNumericPasting"
                                 LostFocus="OnOpacityLostFocus"
                                 KeyDown="OnSettingBoxKeyDown" />
                        <TextBlock x:Name="OpacityText" Grid.Column="2" Text="%"
                                   VerticalAlignment="Center" HorizontalAlignment="Left"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontFamily="{DynamicResource AppFont}" FontSize="{DynamicResource FontBodyS}" />
                    </Grid>
                    <!-- ===== 背景图 ===== -->

                    

                    <!-- ===== 提示音 ===== -->                    
                    <Rectangle Style="{StaticResource GroupSeparatorStyle}" />
                    <TextBlock Text="提示音" Style="{StaticResource GroupTitleStyle}" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="日程默认音效" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox x:Name="SoundCombo" Grid.Column="1" Height="26" Margin="0,0,8,0" MinWidth="160"
                                  Style="{StaticResource ComboStyle}" />
                        <Button Grid.Column="2" Content=" 打开目录 " Height="26"
                                HorizontalAlignment="Right"
                                Style="{StaticResource NormalButtonStyle}" Click="OnOpenSoundFolder" />
                    </Grid>

                    <!-- ===== 悬停预览（该功能暂时隐藏，控件保留以供热键/代码引用） ===== -->
                    <Rectangle Style="{StaticResource GroupSeparatorStyle}" Visibility="Collapsed" />
                    <TextBlock Text="悬停预览" Style="{StaticResource GroupTitleStyle}" Margin="0,8,0,0" Visibility="Collapsed" />
                    <Grid Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="悬停延迟（秒）" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="HoverBox" Grid.Column="1" Height="26" Margin="0,0,8,0"
                                 Style="{StaticResource InputBoxStyle}" LostFocus="OnHoverBoxLostFocus"
                                 PreviewTextInput="OnNumericPreviewTextInput"
                                 DataObject.Pasting="OnNumericPasting"
                                 KeyDown="OnSettingBoxKeyDown" />
                        <TextBlock Grid.Column="2" Text="下限 0.01 秒，上限 5 秒" Style="{StaticResource HintTextStyle}" VerticalAlignment="Center" Margin="0,4,0,0" />
                    </Grid>
                    
                    <!-- ===== 功能（开机自启、AI等） ===== -->
                    <Rectangle Style="{StaticResource GroupSeparatorStyle}" />
                    <TextBlock Text="功能" Style="{StaticResource GroupTitleStyle}" />                    
                    <Grid Margin="0,6,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="开机自动启动" VerticalAlignment="Center"
                                   HorizontalAlignment="Left"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontFamily="{DynamicResource AppFont}" FontSize="{DynamicResource FontBody}" />
                        <CheckBox x:Name="AutoStartCheck" Grid.Column="1"
                                  AutomationProperties.Name="开机自动启动"
                                  Height="22" MinWidth="18" VerticalAlignment="Center"
                                  HorizontalAlignment="Right"
                                  Click="OnAutoStartClick" />
                    </Grid>
                    <!--<TextBlock Text="在「启动」文件夹创建快捷方式"
                               Margin="0,2,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextNoteBrush}"
                               FontFamily="{DynamicResource AppFont}" FontSize="{DynamicResource FontCaption}" />-->
                    <!-- ===== AI 投递 ===== -->
                    <Grid Margin="0,8,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="允许AI命令（允许AI通过操作指令创建、修改、删除你的日程或标签）" VerticalAlignment="Center"
                                   HorizontalAlignment="Left"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontFamily="{DynamicResource AppFont}" FontSize="{DynamicResource FontBody}" />
                        <CheckBox x:Name="AiIntegrationCheck" Grid.Column="1"
                                  AutomationProperties.Name="允许AI命令"
                                  Height="22" MinWidth="18" VerticalAlignment="Center"
                                  HorizontalAlignment="Right"
                                  Click="OnAiIntegrationClick" />
                    </Grid>

                    <Button x:Name="ExportAiRuleBtn" Content="查看 AI 操作规则"
                            Width="125" Height="26" Margin="0,6,8,0"
                            HorizontalAlignment="Left"
                            Style="{StaticResource NormalButtonStyle}"
                            IsEnabled="{Binding IsChecked, ElementName=AiIntegrationCheck}"
                            Click="OnExportAiRuleClick" />
                    <!--<TextBlock Text="允许通过AI操作本程序"
                               Margin="0,2,0,0" TextWrapping="Wrap"
                               HorizontalAlignment="Left" TextAlignment="Left"
                               Foreground="{DynamicResource TextNoteBrush}"
                               FontFamily="{DynamicResource AppFont}" FontSize="{DynamicResource FontCaption}" />-->

                    <!-- ===== 数据管理（按要求隐藏；功能与事件处理器一律保留：把下面这层 StackPanel
                         的 Visibility 改回 Visible 即可原样恢复） ===== -->
                    <StackPanel Visibility="Collapsed">
                    <Rectangle Style="{StaticResource GroupSeparatorStyle}" />
                    <TextBlock Text="数据管理" Style="{StaticResource GroupTitleStyle}" />                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="打开数据目录" Width="120" Height="26" Margin="0,0,8,0"
                                Style="{StaticResource NormalButtonStyle}" Click="OnOpenDataFolder" />
                        <Button Content="导出 JSON" Width="100" Height="26" Margin="0,0,8,0"
                                Style="{StaticResource NormalButtonStyle}" Click="OnExportJson" />
                        <Button Content="导出 CSV" Width="100" Height="26"
                                Style="{StaticResource NormalButtonStyle}" Click="OnExportCsv" />
                    </StackPanel>
                    </StackPanel>
                    <!-- ===== 标签 ===== -->
                    <Rectangle Style="{StaticResource GroupSeparatorStyle}" />
                    <TextBlock Text="标签" Style="{StaticResource GroupTitleStyle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <ListBox x:Name="TagList" Grid.Column="0" Height="110" Margin="0,8,8,0"
                                 Background="{DynamicResource BgInputBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderWeakBrush}"
                                 FontFamily="{DynamicResource AppFont}" FontSize="{DynamicResource FontBody}">
                            <!-- 行容器：覆盖系统默认 ListBoxItem 模板。
                                 Aero2 默认悬停/选中是写死的半透明蓝（#1F26A0DA / #3DDADADA），不引用 HighlightBrush、
                                 无法换色，故此处整体替换为与全局一致的浅白悬停/选中（BgHoverBrush）；
                                 保留选中反馈，供右侧「修改 / 删除」定位目标行。 -->
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="4,2" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" Background="Transparent"
                                                        CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgHoverBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgHoverBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <!-- 仅显示标签名（已去掉前面的色块） -->
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Column="1" Margin="0,8,0,0">
                            <Button Content="新建标签" Height="26"
                                    Style="{StaticResource NormalButtonStyle}" Click="OnCreateTagClick" />
                            <Button Content="修改" Height="26" Margin="0,6,0,0"
                                Style="{StaticResource NormalButtonStyle}" Click="OnEditTagClick" />
                            <Button Content="删除" Height="26" Margin="0,6,0,0"
                                Style="{StaticResource DangerButtonStyle}" Click="OnRemoveTagClick" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="18,0,18,0">
                <Button Content="关闭" HorizontalAlignment="Right" Width="88" Height="30"
                        Style="{StaticResource NormalButtonStyle}" Click="OnCloseClick" />
            </Grid>
        </Grid>
    </Border>
</Window>
