<Window x:Class="ScheduleReminder.Views.TagManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:ScheduleReminder.Controls"
        Title="标签管理"
        Width="549" Height="392"
        MinWidth="549" MinHeight="392"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        Background="Transparent" ShowInTaskbar="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                            GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="FieldLabel13" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Note12" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextNoteBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SwatchButtonStyle" TargetType="Button" BasedOn="{StaticResource NormalButtonStyle}">
            <Setter Property="Width" Value="62" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="MiniButtonStyle" TargetType="Button" BasedOn="{StaticResource NormalButtonStyle}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="TagListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="{DynamicResource RadiusWindow}"
            Background="{DynamicResource WindowBgBrush}"
            BorderBrush="{DynamicResource BorderWeakBrush}" BorderThickness="1">
        <Canvas Width="547" Height="390" Background="Transparent">

            <!-- 标题栏：34 像素 -->
            <Border Canvas.Left="0" Canvas.Top="0" Width="547" Height="34"
                    Background="Transparent"
                    MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid>
                    <TextBlock x:Name="TitleText" Text="标签管理"
                               Margin="16,0,60,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               FontFamily="{DynamicResource AppFont}"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0">
                        <Button Width="22" Height="22" Padding="0"
                                Style="{StaticResource TitleBarIconButtonStyle}"
                                Click="OnMinimizeClick" ToolTip="最小化">
                            <controls:IconView Glyph="{StaticResource IconMinimize}" IconSize="13"
                                               IconStroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                        </Button>
                        <Button Width="22" Height="22" Padding="0"
                                Style="{StaticResource TitleBarCloseButtonStyle}"
                                Click="OnCloseClick" ToolTip="关闭">
                            <controls:IconView Glyph="{StaticResource IconClose}" IconSize="13"
                                               IconStroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 主体画布：left/right 16，top 38，bottom 16 -->
            <Canvas Canvas.Left="16" Canvas.Top="38" Width="515" Height="336">

                <!-- 左侧标题 -->
                <TextBlock x:Name="EditTitleText" Text="新建标签"
                           Canvas.Left="0" Canvas.Top="0" Width="305" Height="20"
                           VerticalAlignment="Center"
                           FontFamily="{DynamicResource AppFont}"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />

                <!-- 右侧标题 -->
                <TextBlock Text="标签列表"
                           Canvas.Left="330" Canvas.Top="0" Width="185" Height="20"
                           VerticalAlignment="Center"
                           Style="{StaticResource FieldLabel13}" />

                <!-- 中间竖线：装饰线，不再作为窗格列 -->
                <Border Canvas.Left="317" Canvas.Top="0" Width="1" Height="336"
                        Background="{DynamicResource BorderWeakBrush40}" />

                <!-- 左侧内容：top 26，bottom 298 -->
                <TextBlock Text="标签名（必填）"
                           Canvas.Left="0" Canvas.Top="26" Width="220" Height="18"
                           Style="{StaticResource FieldLabel13}" />
                <TextBlock x:Name="NameCounter" Text="0/6"
                           Canvas.Left="220" Canvas.Top="26" Width="85" Height="18"
                           TextAlignment="Right"
                           Style="{StaticResource Note12}" />

                <TextBox x:Name="NameBox" MaxLength="6"
                         Canvas.Left="0" Canvas.Top="46" Width="305" Height="32"
                         Style="{StaticResource InputBoxStyle}"
                         TextChanged="OnNameTextChanged" />

                <TextBlock Text="背景颜色"
                           Canvas.Left="0" Canvas.Top="90" Width="150" Height="18"
                           Style="{StaticResource FieldLabel13}" />
                <TextBlock Text="字体颜色"
                           Canvas.Left="155" Canvas.Top="90" Width="150" Height="18"
                           TextAlignment="Right"
                           Style="{StaticResource FieldLabel13}" />

                <Button x:Name="BgSwatch"
                        Canvas.Left="0" Canvas.Top="110"
                        Style="{StaticResource SwatchButtonStyle}"
                        Cursor="Hand" Click="OnBgColorClick" ToolTip="选择背景颜色">
                    <Rectangle x:Name="BgRect" Width="54" Height="24" RadiusX="3" RadiusY="3"
                               Fill="{StaticResource CheckerBrush}" />
                </Button>
                <Button Content="默认"
                        Canvas.Left="66" Canvas.Top="110"
                        Style="{StaticResource MiniButtonStyle}"
                        Cursor="Hand" ToolTip="默认透明" Click="OnBgTransparentClick" />

                <Button x:Name="FontSwatch"
                        Canvas.Left="203" Canvas.Top="110"
                        Style="{StaticResource SwatchButtonStyle}"
                        Cursor="Hand" Click="OnFontColorClick" ToolTip="选择字体颜色">
                    <Rectangle x:Name="FontRect" Width="54" Height="24" RadiusX="3" RadiusY="3"
                               Fill="{StaticResource CheckerBrush}" />
                </Button>
                <Button Content="默认"
                        Canvas.Left="269" Canvas.Top="110"
                        Style="{StaticResource MiniButtonStyle}"
                        Cursor="Hand" ToolTip="跟随系统设置" Click="OnFontFollowSystemClick" />

                <TextBlock Text="预览"
                           Canvas.Left="0" Canvas.Top="154" Width="305" Height="18"
                           Style="{StaticResource FieldLabel13}" />

                <Canvas Canvas.Left="0" Canvas.Top="176" Width="305" Height="58">
                    <Rectangle Canvas.Left="0" Canvas.Top="0" Width="305" Height="58"
                               Stroke="{DynamicResource BorderWeakBrush}" StrokeThickness="1"
                               StrokeDashArray="4 3" RadiusX="6" RadiusY="6"
                               Fill="Transparent" />
                    <Border x:Name="PreviewBar" Canvas.Left="8" Canvas.Top="11"
                            Width="289" Height="36" CornerRadius="7"
                            Background="Transparent">
                        <Grid Margin="10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="PreviewTime" Grid.Column="0" Text="09:00"
                                       VerticalAlignment="Center"
                                       FontFamily="{DynamicResource AppFont}"
                                       FontSize="11"
                                       Foreground="{Binding Foreground, ElementName=PreviewTitle}" />

                            <TextBlock x:Name="PreviewTitle" Grid.Column="1" Text="预览标题预览标题"
                                       Margin="4,0,0,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       FontFamily="{DynamicResource AppFont}"
                                       FontSize="{DynamicResource FontBody}"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />

                            <Border x:Name="PreviewTag" Grid.Column="2" Margin="10,0,0,0"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Padding="8,2" CornerRadius="4" Background="Transparent">
                                <TextBlock x:Name="PreviewTagText" Text="预览标签"
                                           FontFamily="{DynamicResource AppFont}"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Border>
                        </Grid>
                    </Border>
                </Canvas>

                <TextBlock Text="提醒铃"
                           Canvas.Left="0" Canvas.Top="246" Width="305" Height="18"
                           Style="{StaticResource FieldLabel13}" />

                <ComboBox x:Name="SoundCombo"
                          Canvas.Left="0" Canvas.Top="266" Width="305" Height="32"
                          Style="{StaticResource MaterialCombo}" />

                <!-- 右侧列表 -->
                <Border Canvas.Left="330" Canvas.Top="26" Width="185" Height="272"
                        CornerRadius="4"
                        Background="{DynamicResource BgInputBrush}"
                        BorderBrush="{DynamicResource BorderWeakBrush}" BorderThickness="1">
                    <ListBox x:Name="TagList" Padding="4,6"
                             ItemContainerStyle="{StaticResource TagListItemStyle}"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             FontFamily="{DynamicResource AppFont}"
                             FontSize="{DynamicResource FontBody}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             SelectionChanged="OnTagListSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- 左下按钮：宽 80，高 24，整体在 305 宽区域内精确居中 -->
                <StackPanel Canvas.Left="66.5" Canvas.Top="312" Width="172" Height="24"
                            Orientation="Horizontal">
                    <Button Content="保存" Width="80" Height="24"
                            Style="{StaticResource NormalButtonStyle}" Click="OnSaveClick" />
                    <Button Content="取消" Width="80" Height="24" Margin="12,0,0,0"
                            Style="{StaticResource NormalButtonStyle}" Click="OnCancelClick" />
                </StackPanel>

                <!-- 右下按钮：高 28，底边对齐；与 185 宽的右侧区域同步 -->
                <Grid Canvas.Left="330" Canvas.Top="308" Width="185" Height="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="新建" Height="28" Margin="0,0,2,0"
                            Style="{StaticResource NormalButtonStyle}" Click="OnNewClick" />
                    <Button Grid.Column="1" Content="修改" Height="28" Margin="2,0,2,0"
                            Style="{StaticResource NormalButtonStyle}" Click="OnEditClick" />
                    <Button Grid.Column="2" Content="删除" Height="28" Margin="2,0,0,0"
                            Style="{StaticResource DangerButtonStyle}" Click="OnDeleteClick" />
                </Grid>
            </Canvas>
        </Canvas>
    </Border>
</Window>
