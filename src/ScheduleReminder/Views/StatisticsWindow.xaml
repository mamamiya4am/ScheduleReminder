<Window x:Class="ScheduleReminder.Views.StatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:ScheduleReminder.Views"
        Title="统计数据"
        Width="865" Height="500" MinWidth="780" MinHeight="450"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResize"
        Background="Transparent" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="StatsDateButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="88" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderWeakBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
            <Setter Property="FontSize" Value="{DynamicResource FontBodyS}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BgBtnBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatsMetricLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
            <Setter Property="FontSize" Value="{DynamicResource FontBodyS}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>

        <Style x:Key="StatsMetricValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
            <Setter Property="FontSize" Value="{DynamicResource FontBodyL}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>

        <Style x:Key="StatsSegmentStyle" TargetType="ToggleButton">
            <!-- 区间 / 粒度 / 划分共用：同一尺寸、圆角和选中/悬浮状态由触发器统一管理。 -->
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
            <Setter Property="FontSize" Value="{DynamicResource FontBodyS}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BgBtnBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderWeakBrush}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BgBtnBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatsLegendStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,12,5" />
            <Setter Property="Padding" Value="2,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <!-- 透明背景覆盖整块图例，保证色块与文字之间的空白也能点击。 -->
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="Swatch" Width="14" Height="3" CornerRadius="1.5"
                                        Background="{TemplateBinding BorderBrush}"
                                        VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="Swatch" Property="Opacity" Value="0.25" />
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatsCalendarDayStyle" TargetType="Button">
            <Setter Property="Width" Value="27" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
            <Setter Property="FontSize" Value="{DynamicResource FontBodyS}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.25" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
    <Border x:Name="RootBorder"
            CornerRadius="{DynamicResource RadiusWindow}"
            BorderBrush="{DynamicResource BorderWeakBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="Transparent"
                    MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="统计数据" Margin="14,0,80,0" VerticalAlignment="Center"
                               FontFamily="{DynamicResource AppFont}" FontSize="{DynamicResource FontBodyL}"
                               FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0">
                        <Button Style="{StaticResource TitleBarIconButtonStyle}" Click="OnMinimizeClick"
                                ToolTip="最小化">
                            <Path Data="{StaticResource IconMinimize}"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  StrokeThickness="1.5" Stretch="Uniform"
                                  Width="12" Height="12" SnapsToDevicePixels="True" />
                        </Button>
                        <Button Style="{StaticResource TitleBarCloseButtonStyle}" Click="OnCloseClick"
                                ToolTip="关闭">
                            <Path Data="{StaticResource IconClose}"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  StrokeThickness="1.5" Stretch="Uniform"
                                  Width="13" Height="13" SnapsToDevicePixels="True" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 内容 -->
            <Grid Grid.Row="1" Margin="16,8,16,14" PreviewKeyDown="OnWindowPreviewKeyDown">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 概览 -->
                <Grid Grid.Row="0" Margin="2,0,2,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TotalValueText" Text="0"
                                   FontFamily="{DynamicResource AppFont}"
                                   FontSize="30" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text=" 条日程" VerticalAlignment="Bottom" Margin="0,0,0,4"
                                   FontFamily="{DynamicResource AppFont}"
                                   FontSize="{DynamicResource FontBodyS}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <StackPanel Margin="20,0,0,0">
                            <TextBlock Text="平均" Style="{StaticResource StatsMetricLabelStyle}" />
                            <TextBlock x:Name="AverageValueText" Text="0" Style="{StaticResource StatsMetricValueStyle}" />
                        </StackPanel>
                        <StackPanel Margin="20,0,0,0">
                            <TextBlock Text="完成率" Style="{StaticResource StatsMetricLabelStyle}" />
                            <TextBlock x:Name="RateValueText" Text="0" Style="{StaticResource StatsMetricValueStyle}" />
                        </StackPanel>
                        <StackPanel Margin="20,0,0,0">
                            <TextBlock Text="峰值" Style="{StaticResource StatsMetricLabelStyle}" />
                            <TextBlock x:Name="PeakValueText" Text="0" Style="{StaticResource StatsMetricValueStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- 区间条 -->
                <Grid Grid.Row="1" Margin="2,0,2,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="区间" VerticalAlignment="Center" Margin="0,0,6,0"
                               FontFamily="{DynamicResource AppFont}"
                               FontSize="{DynamicResource FontBodyS}"
                               Foreground="{DynamicResource TextSecondaryBrush}" />

                    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center">
                        <StackPanel x:Name="RangePanel" Orientation="Horizontal" VerticalAlignment="Center" />
                    </ScrollViewer>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="8,0,0,0">
                        <Button x:Name="StartDateButton" Style="{StaticResource StatsDateButtonStyle}"
                                Click="OnStartDateClick" ToolTip="开始日期" />
                        <TextBlock Text="—" Margin="6,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Button x:Name="EndDateButton" Style="{StaticResource StatsDateButtonStyle}"
                                Click="OnEndDateClick" ToolTip="结束日期" />
                        <TextBlock x:Name="DaysText" Text="共 0 天" Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   FontFamily="{DynamicResource AppFont}"
                                   FontSize="{DynamicResource FontCaption}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Grid>

                <!-- 粒度 -->
                <Grid Grid.Row="2" Margin="2,0,2,4">
                    <TextBlock Text="粒度" Width="34" HorizontalAlignment="Left" VerticalAlignment="Center"
                               FontFamily="{DynamicResource AppFont}"
                               FontSize="{DynamicResource FontBodyS}"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <StackPanel x:Name="GranularityPanel" Orientation="Horizontal" Margin="38,0,0,0" />
                </Grid>

                <!-- 划分 -->
                <Grid Grid.Row="3" Margin="2,0,2,6">
                    <TextBlock Text="划分" Width="34" HorizontalAlignment="Left" VerticalAlignment="Center"
                               FontFamily="{DynamicResource AppFont}"
                               FontSize="{DynamicResource FontBodyS}"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <StackPanel x:Name="ViewPanel" Orientation="Horizontal" Margin="38,0,0,0" />
                </Grid>

                <!-- 图例 + 图表 -->
                <Grid Grid.Row="4" Margin="2,0,2,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <WrapPanel x:Name="LegendPanel" Grid.Row="0" HorizontalAlignment="Center"
                               Margin="0,0,0,4" />

                    <Grid Grid.Row="1">
                        <views:StatisticsChart x:Name="Chart" MinHeight="150" />
                        <TextBlock x:Name="EmptyText" Text="正在统计…"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontFamily="{DynamicResource AppFont}"
                                   FontSize="{DynamicResource FontBody}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>

    <!-- 自定义日期弹层 -->
    <Popup x:Name="DatePopup" Placement="Bottom" StaysOpen="False"
           AllowsTransparency="True" PopupAnimation="Fade">
        <Border Background="{DynamicResource PopupBgBrush}"
                BorderBrush="{DynamicResource BorderStrongBrush}"
                BorderThickness="1" CornerRadius="8" Padding="8" Width="214"
                PreviewKeyDown="OnWindowPreviewKeyDown">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Button x:Name="CalendarPrevButton" Width="24" Height="24" HorizontalAlignment="Left"
                            Style="{StaticResource TitleBarButtonStyle}" Click="OnCalendarPrevClick">
                        <Path Data="M10 3L5 8l5 5" Stroke="{DynamicResource TextSecondaryBrush}"
                              StrokeThickness="1.6" Stretch="Uniform" Width="10" Height="10" />
                    </Button>
                    <TextBlock x:Name="CalendarMonthText" Text=""
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontFamily="{DynamicResource AppFont}"
                               FontSize="{DynamicResource FontBody}"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <Button x:Name="CalendarNextButton" Width="24" Height="24" HorizontalAlignment="Right"
                            Style="{StaticResource TitleBarButtonStyle}" Click="OnCalendarNextClick">
                        <Path Data="M6 3l5 5-5 5" Stroke="{DynamicResource TextSecondaryBrush}"
                              StrokeThickness="1.6" Stretch="Uniform" Width="10" Height="10" />
                    </Button>
                </Grid>
                <UniformGrid Columns="7" Margin="0,0,0,2">
                    <TextBlock Text="一" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" />
                    <TextBlock Text="二" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" />
                    <TextBlock Text="三" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" />
                    <TextBlock Text="四" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" />
                    <TextBlock Text="五" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" />
                    <TextBlock Text="六" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" />
                    <TextBlock Text="日" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" />
                </UniformGrid>
                <UniformGrid x:Name="CalendarDays" Columns="7" Rows="6" />
                <TextBlock x:Name="CalendarHint" Text="" Margin="2,7,2,0"
                           FontFamily="{DynamicResource AppFont}"
                           FontSize="{DynamicResource FontCaption}"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
        </Border>
    </Popup>
    </Grid>
</Window>
