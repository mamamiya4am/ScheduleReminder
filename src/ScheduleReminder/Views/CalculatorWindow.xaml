<Window x:Class="ScheduleReminder.Views.CalculatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:calc="clr-namespace:ScheduleReminder.Tools.Calculator"
        Title="计算器"
        Width="400" Height="480" MinWidth="360" MinHeight="410"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResize"
        Background="Transparent" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <!-- 自绘无边框窗口：CaptionHeight=0（拖动由代码 DragMove 完成），四边 6px 交给 WindowChrome 做缩放命中 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 数字框：高 24、左内边距 8 / 右内边距 12、圆角 5、字号 12（随缩放档位整体放大） -->
        <Style x:Key="CalcNumBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="8,0,12,0" />
            <Setter Property="FontSize" Value="{DynamicResource FontBody}" />
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource BgInputBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderWeakBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" CornerRadius="5"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 行右侧按钮（首行「清空」/ 其余「Del」）：34×24、左外边距 8、圆角 8、字号 11 -->
        <Style x:Key="CalcRowButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="{DynamicResource FontBodyS}" />
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource BgBtnBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderWeakBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 数字行：数字框 + 右侧按钮 -->
        <DataTemplate DataType="{x:Type calc:NumberCell}">
            <Grid Margin="0,2,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TextBox Style="{StaticResource CalcNumBoxStyle}"
                             Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                             PreviewTextInput="OnNumberPreviewTextInput"
                             DataObject.Pasting="OnNumberPasting" />
                    <!-- 占位文字：值为空时显示（WPF 的 TextBox 没有原生占位符） -->
                    <TextBlock Text="输入数字" Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               FontFamily="{DynamicResource AppFont}"
                               FontSize="{DynamicResource FontBodyS}"
                               Foreground="{DynamicResource TextNoteBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Value}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Grid Grid.Column="1">
                    <!-- 首行：清空 -->
                    <Button Content="清空" ToolTip="清空全部" Click="OnClearClick">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource CalcRowButtonStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFirstNumber}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <!-- 其余行：Del -->
                    <Button Content="Del" ToolTip="删除这一行（数字及其下方运算符）" Click="OnDeleteClick">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource CalcRowButtonStyle}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFirstNumber}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- 运算符行：下拉框（宽约 60 = 原型 5em、高 18） -->
        <DataTemplate DataType="{x:Type calc:OperatorCell}">
            <Grid Margin="0,0,0,2">
                <ComboBox Width="76" Height="18" Padding="6,0,6,0" HorizontalAlignment="Left"
                          FontSize="{DynamicResource FontBody}" FontFamily="{DynamicResource AppFont}"
                          Style="{StaticResource ComboStyle}"
                          SelectedValuePath="Tag"
                          SelectedValue="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <ComboBoxItem Tag="">
                        <TextBlock Text="运算符"
                                   FontFamily="{DynamicResource AppFont}"
                                   FontSize="{DynamicResource FontBodyS}"
                                   Foreground="{DynamicResource TextNoteBrush}" />
                    </ComboBoxItem>
                    <ComboBoxItem Tag="+">
                        <TextBlock FontFamily="{DynamicResource AppFont}"
                                   FontSize="{DynamicResource FontBody}"
                                   Foreground="{DynamicResource TextPrimaryBrush}">
                            <Run Text="+ " />
                            <Run Text="加" FontSize="{DynamicResource FontBodyS}"
                                 Foreground="{DynamicResource TextNoteBrush}" />
                        </TextBlock>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="-">
                        <TextBlock FontFamily="{DynamicResource AppFont}"
                                   FontSize="{DynamicResource FontBody}"
                                   Foreground="{DynamicResource TextPrimaryBrush}">
                            <Run Text="− " />
                            <Run Text="减" FontSize="{DynamicResource FontBodyS}"
                                 Foreground="{DynamicResource TextNoteBrush}" />
                        </TextBlock>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="*">
                        <TextBlock FontFamily="{DynamicResource AppFont}"
                                   FontSize="{DynamicResource FontBody}"
                                   Foreground="{DynamicResource TextPrimaryBrush}">
                            <Run Text="× " />
                            <Run Text="乘" FontSize="{DynamicResource FontBodyS}"
                                 Foreground="{DynamicResource TextNoteBrush}" />
                        </TextBlock>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="/">
                        <TextBlock FontFamily="{DynamicResource AppFont}"
                                   FontSize="{DynamicResource FontBody}"
                                   Foreground="{DynamicResource TextPrimaryBrush}">
                            <Run Text="÷ " />
                            <Run Text="除" FontSize="{DynamicResource FontBodyS}"
                                 Foreground="{DynamicResource TextNoteBrush}" />
                        </TextBlock>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="^">
                        <TextBlock FontFamily="{DynamicResource AppFont}"
                                   FontSize="{DynamicResource FontBody}"
                                   Foreground="{DynamicResource TextPrimaryBrush}">
                            <Run Text="^ " />
                            <Run Text="幂" FontSize="{DynamicResource FontBodyS}"
                                 Foreground="{DynamicResource TextNoteBrush}" />
                        </TextBlock>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="√">
                        <TextBlock FontFamily="{DynamicResource AppFont}"
                                   FontSize="{DynamicResource FontBody}"
                                   Foreground="{DynamicResource TextPrimaryBrush}">
                            <Run Text="√ " />
                            <Run Text="根号" FontSize="{DynamicResource FontBodyS}"
                                 Foreground="{DynamicResource TextNoteBrush}" />
                        </TextBlock>
                    </ComboBoxItem>
                </ComboBox>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <!-- 窗口四周留 20 像素透明边距；外框 400×480，可见内容区为 360×440 -->
    <Grid>
        <Border Margin="20" CornerRadius="{DynamicResource RadiusWindow}"
                Background="{DynamicResource WindowBgSolidBrush}"
                BorderBrush="{DynamicResource BorderWeakBrush}" BorderThickness="1"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <!-- 原型：0 18px 60px rgba(0,0,0,0.55) -->
                <DropShadowEffect Color="Black" Direction="90" ShadowDepth="18" BlurRadius="60" Opacity="0.55" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <!-- 标题栏 34：与主程序各窗口写死 34 的做法一致。
                         App.xaml 的 TitleBarHeight（标题栏高度）是 Double 资源，直接赋给 RowDefinition.Height 会类型不符。 -->
                    <RowDefinition Height="34" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ============ 标题栏 ============ -->
                <Border Grid.Row="0" Background="Transparent"
                        MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                    <Grid>
                        <TextBlock Text="计算器" Margin="12,0,0,0"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   FontSize="13" FontWeight="SemiBold"
                                   FontFamily="{DynamicResource AppFont}"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0">
                            <Button Style="{StaticResource TitleBarIconButtonStyle}"
                                    ToolTip="最小化" Click="OnMinimizeClick">
                                <Path Data="{StaticResource IconMinimize}"
                                      Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                      StrokeThickness="1.5" Stretch="Uniform"
                                      Width="13" Height="13" SnapsToDevicePixels="True" />
                            </Button>
                            <Button Style="{StaticResource TitleBarCloseButtonStyle}"
                                    ToolTip="关闭" Click="OnCloseClick">
                                <Path Data="{StaticResource IconClose}"
                                      Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                      StrokeThickness="1.5" Stretch="Uniform"
                                      Width="13" Height="13" SnapsToDevicePixels="True" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============ 主体 ============ -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 级联行区：左右 18、上下 2，可纵向滚动 -->
                    <ScrollViewer Grid.Row="0" Padding="18,8,18,2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Cells}" />
                    </ScrollViewer>

                    <!-- 结果面板：外边距 0/14/2、内边距 2/14，圆角 12 -->
                    <Border Grid.Row="1" Margin="14,0,14,12" Padding="14,6,14,2"
                            CornerRadius="{DynamicResource RadiusWindow}"
                            BorderBrush="{DynamicResource BorderWeakBrush}" BorderThickness="1"
                            Background="{DynamicResource BgInputBrush}">
                        <StackPanel>
                            <TextBlock Text="{Binding ExpressionText}"
                                       FontFamily="{DynamicResource AppFont}"
                                       FontSize="{DynamicResource FontBody}"
                                       Foreground="{DynamicResource TextNoteBrush}"
                                       TextWrapping="Wrap" MinHeight="16" Margin="0,0,0,12" />
                            <TextBlock Text="{Binding ValueText}" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
                                        <Setter Property="FontSize" Value="24" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        <Style.Triggers>
                                            <!-- 错误态：今天高亮边框色、14 像素、常规字重 -->
                                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                                <Setter Property="FontSize" Value="{DynamicResource FontBodyL}" />
                                                <Setter Property="FontWeight" Value="Normal" />
                                                <Setter Property="Foreground" Value="{DynamicResource TodayBorderBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
