<Window x:Class="ScheduleReminder.Views.WorldClockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="世界时钟"
        Width="400" Height="440" MinWidth="360" MinHeight="400"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResize"
        Background="Transparent" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <!-- 自绘无边框窗口：CaptionHeight=0（拖动由代码 DragMove 完成），四边 6px 交给 WindowChrome 做缩放命中 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 城市行容器：去掉选中与悬停底色，内容横向撑满行宽 -->
        <Style x:Key="CityRowItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="Transparent" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 上下箭头：18×16，去边框透明底，灰字；悬停换底色，禁用时透明度 0.25 -->
        <Style x:Key="ArrowButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.25" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 删除按钮：20×20，去边框透明底，悬停换底色 -->
        <Style x:Key="RowDeleteButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 行间分割线：1 像素、40% 透明度，末行不画 -->
        <Style x:Key="RowSeparatorStyle" TargetType="Rectangle">
            <Setter Property="Height" Value="1" />
            <Setter Property="Opacity" Value="0.4" />
            <Setter Property="Fill" Value="{DynamicResource BorderWeakBrush}" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
    </Window.Resources>

    <!-- 窗口四周留 20 像素透明边距，用来承载投影；可见内容区为 360×400 -->
    <Grid>
        <Border Margin="20" CornerRadius="{DynamicResource RadiusWindow}"
                Background="{DynamicResource WindowBgSolidBrush}"
                BorderBrush="{DynamicResource BorderWeakBrush}" BorderThickness="1"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <!-- 原型：0 18px 60px rgba(0,0,0,0.55) -->
                <DropShadowEffect Color="Black" Direction="90" ShadowDepth="18" BlurRadius="60" Opacity="0.55" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ============ 标题栏（无图标，仅程序名，左定位 12） ============ -->
                <Border Grid.Row="0" Background="Transparent"
                        MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                    <Grid>
                        <TextBlock Text="世界时钟" Margin="12,0,0,0"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   FontSize="13" FontWeight="SemiBold"
                                   FontFamily="{DynamicResource AppFont}"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0">
                            <Button Style="{StaticResource TitleBarIconButtonStyle}"
                                    ToolTip="最小化" Click="OnMinimizeClick">
                                <Path Data="{StaticResource IconMinimize}"
                                      Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                      StrokeThickness="1.5" Stretch="Uniform"
                                      Width="13" Height="13" SnapsToDevicePixels="True" />
                            </Button>
                            <Button Style="{StaticResource TitleBarCloseButtonStyle}"
                                    ToolTip="关闭" Click="OnCloseClick">
                                <Path Data="{StaticResource IconClose}"
                                      Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                      StrokeThickness="1.5" Stretch="Uniform"
                                      Width="13" Height="13" SnapsToDevicePixels="True" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============ 主体：上 0、左右 14、下 6 ============ -->
                <Grid Grid.Row="1" Margin="14,0,14,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />   <!-- 添加区 -->
                        <RowDefinition Height="*" />    <!-- 城市列表 -->
                    </Grid.RowDefinitions>

                    <!-- 添加区：高 30，一个下拉占满宽度 -->
                    <ComboBox Grid.Row="0" x:Name="PickerBox" Height="26" VerticalAlignment="Center"
                              Style="{StaticResource ComboStyle}"
                              SelectionChanged="OnPickerSelectionChanged" />

                    <!-- 城市列表：可纵向滚动；空列表时显示居中引导文案 -->
                    <Grid Grid.Row="1">
                        <ListBox x:Name="CityList"
                                 ItemsSource="{Binding Rows}"
                                 ItemContainerStyle="{StaticResource CityRowItemStyle}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- 行内边距上下 6、左右 4 -->
                                        <Grid Grid.Row="0" Margin="4,6,4,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- 上下箭头：列宽 18、两键间距 2 -->
                                            <StackPanel Grid.Column="0" Orientation="Vertical" Width="18" Margin="0,0,6,0">
                                                <Button Content="▲" Style="{StaticResource ArrowButtonStyle}"
                                                        ToolTip="上移" IsEnabled="{Binding CanMoveUp}"
                                                        Click="OnMoveUpClick" />
                                                <Button Content="▼" Style="{StaticResource ArrowButtonStyle}"
                                                        Margin="0,2,0,0" ToolTip="下移"
                                                        IsEnabled="{Binding CanMoveDown}"
                                                        Click="OnMoveDownClick" />
                                            </StackPanel>

                                            <!-- 城市名 + 国家名 + 当地日期 -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="{DynamicResource FontBody}"
                                                               FontFamily="{DynamicResource AppFont}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{Binding Country}" Margin="6,0,0,0"
                                                               FontSize="{DynamicResource FontBodyS}"
                                                               FontFamily="{DynamicResource AppFont}"
                                                               Foreground="{DynamicResource TextNoteBrush}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding DateText}" Margin="0,1,0,0"
                                                           FontSize="{DynamicResource FontBodyS}"
                                                           FontFamily="{DynamicResource AppFont}"
                                                           Foreground="{DynamicResource TextNoteBrush}" />
                                            </StackPanel>

                                            <!-- 当地时刻 + 时差（右对齐） -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding TimeText}" HorizontalAlignment="Right"
                                                           FontSize="20" FontWeight="SemiBold"
                                                           FontFamily="{DynamicResource MonoFont}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="{Binding DifferenceText}" Margin="0,2,0,0"
                                                           HorizontalAlignment="Right"
                                                           FontSize="{DynamicResource FontBodyS}"
                                                           FontFamily="{DynamicResource AppFont}"
                                                           Foreground="{DynamicResource TextNoteBrush}" />
                                            </StackPanel>

                                            <!-- 删除 -->
                                            <Button Grid.Column="3" Content="×" ToolTip="移除"
                                                    Style="{StaticResource RowDeleteButtonStyle}"
                                                    Click="OnRemoveClick" />
                                        </Grid>

                                        <!-- 行间 1 像素分割线，末行不画 -->
                                        <Rectangle Grid.Row="1">
                                            <Rectangle.Style>
                                                <Style TargetType="Rectangle" BasedOn="{StaticResource RowSeparatorStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLast}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Rectangle.Style>
                                        </Rectangle>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- 空状态：列表为空时居中显示 -->
                        <TextBlock x:Name="EmptyHint" Text="还没有城市，从上方选择添加"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="{DynamicResource FontBodyS}"
                                   FontFamily="{DynamicResource AppFont}"
                                   Foreground="{DynamicResource TextNoteBrush}"
                                   Visibility="Collapsed" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
