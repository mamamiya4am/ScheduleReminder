<Window x:Class="ScheduleReminder.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:converters="clr-namespace:ScheduleReminder.Converters"
        xmlns:views="clr-namespace:ScheduleReminder.Views"
        Title="日程提醒"
        Width="1000" Height="700" MinWidth="880" MinHeight="615"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResize"
        Background="Transparent" ShowInTaskbar="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <!-- 自绘无边框窗口：CaptionHeight=0（拖动由代码 DragMove 完成），四边 6px 交给 WindowChrome 做缩放命中 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <converters:ScheduleBgBrushConverter x:Key="ScheduleBg" />
        <converters:ScheduleFontBrushConverter x:Key="ScheduleFont" />
        <converters:OtherMonthOpacityConverter x:Key="OtherMonthOpacity" />
        <converters:MonthBorderOpacityConverter x:Key="MonthBorderOpacity" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- 年 / 月切换箭头按钮：32×32，距文本 16 -->
        <Style x:Key="NavButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <!-- 左列小按键：40×40，图标 16px。
             OPT-020⑤：改继承 TitleBarButtonStyle（沿用它的模板与 Bd 部件）——无边框 + 悬停浅白层
             + 前景 78% 淡→满浓度；图标也已改绑 Foreground，故删掉原来那条
             「悬停把 Foreground 改成危险红」的死代码触发器（旧图标不绑前景，改了也不生效）。 -->
        <Style x:Key="ToolButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="0" />
            <!-- 关掉 WPF 默认的键盘焦点虚线框：它只在"当前获得焦点"的那个按钮上出现，
                 会让左列按钮在常态下看起来一个有框、一个没框（用户反馈"不统一"）。 -->
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <!-- 星期表头：12px SemiBold，不含农历 -->
        <Style x:Key="WeekdayHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
            <Setter Property="FontSize" Value="{DynamicResource FontBody}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 日期号：14px SemiBold；今日落在「今日色」实心圆上 → 文字用自动黑 / 白（当月内过往 / 未来同色） -->
        <Style x:Key="DayNumberStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
            <Setter Property="FontSize" Value="{DynamicResource FontBodyL}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <!-- 今日：圆底为「今日色」→ 数字取黑 / 白中与圆底对比度更高者 -->
                <DataTrigger Binding="{Binding IsToday}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TodayOnColorBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 右上角小字（节假日 &gt; 节气 &gt; 农历）：10px，与日期号同色 -->
        <Style x:Key="SubLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
            <Setter Property="FontSize" Value="{DynamicResource FontCaption}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsToday}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 周视图日期头：24×24 数字槽（不强制与月格 22×22 同尺寸）+ 右上角角标；整列边框由列容器负责 -->
        <DataTemplate x:Key="WeekDayHeaderTemplate">
            <Grid Margin="8,4" ClipToBounds="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="24" Height="24" ClipToBounds="False"
                      HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Ellipse Width="24" Height="24" Fill="{DynamicResource TodayBorderBrush}">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding DayText}" Style="{StaticResource DayNumberStyle}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Border Width="12" Height="12" CornerRadius="6"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,-4,-6,0" Background="#FF6B6B"
                            Visibility="{Binding HasTodoPending, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding TodoBadgeText}" FontSize="7.5"
                                   Foreground="#FFF2F2F2"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
                <TextBlock Grid.Column="1" Text="{Binding SubText}"
                           Style="{StaticResource SubLabelStyle}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Margin="4,0,0,0" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SearchRowTemplate">
            <Border Height="30" Padding="8,0" CornerRadius="6" Cursor="Hand"
                    MouseLeftButtonUp="OnSearchResultClick">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="62" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding DateText}" VerticalAlignment="Center"
                               FontSize="{DynamicResource FontBodyS}"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               FontSize="{DynamicResource FontBody}"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Grid.Column="2" Text="{Binding Repeat}"
                               Visibility="{Binding RepeatVisibility}"
                               VerticalAlignment="Center" Margin="8,0,0,0"
                               FontSize="{DynamicResource FontCaption}"
                               Foreground="{DynamicResource TextNoteBrush}" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border CornerRadius="{DynamicResource RadiusWindow}"
            Background="{DynamicResource WindowBgBrush}"
            BorderBrush="{DynamicResource BorderWeakBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ============ 自绘标题栏（H=34，拖动区） ============ -->
            <Border Grid.Row="0" Background="Transparent"
                    MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid>
                    <Image x:Name="AppIconImage" Width="24" Height="24"
                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                                VerticalAlignment="Center" Margin="46,0,0,0">
                        <TextBlock Text="我的日程" VerticalAlignment="Center"
                                   FontSize="13" FontWeight="SemiBold"
                                   FontFamily="{DynamicResource AppFont}"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />

                        <Border x:Name="SearchHost" Margin="14,0,0,0" CornerRadius="6"
                                Background="{x:Null}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="SearchToggle" Grid.Column="0" Width="28" Height="24"
                                        Style="{StaticResource TitleBarIconButtonStyle}"
                                        ToolTip="搜索日程" Click="OnSearchToggleClick">
                                    <Path Data="{StaticResource IconSearch}"
                                          Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                          StrokeThickness="2" Stretch="Uniform"
                                          Width="13" Height="13" SnapsToDevicePixels="True" />
                                </Button>
                                <TextBox x:Name="SearchBox" Grid.Column="1" Width="272"
                                         Visibility="Collapsed"
                                         VerticalContentAlignment="Center" MaxLength="40"
                                         Padding="0,0,4,0" Background="Transparent"
                                         BorderThickness="0"
                                         FontFamily="{DynamicResource AppFont}"
                                         FontSize="{DynamicResource FontBody}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         CaretBrush="{DynamicResource TextPrimaryBrush}"
                                         TextChanged="OnSearchTextChanged"
                                         GotKeyboardFocus="OnSearchBoxGotFocus"
                                         LostKeyboardFocus="OnSearchBoxLostFocus"
                                         PreviewKeyDown="OnSearchBoxKeyDown" />
                            </Grid>
                        </Border>

                        <Popup x:Name="SearchPanel" PlacementTarget="{Binding ElementName=SearchHost}"
                               Placement="Bottom" HorizontalOffset="0" VerticalOffset="4"
                               StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Width="300" MaxHeight="306" Padding="6"
                                    Background="{DynamicResource PopupBgBrush}"
                                    BorderBrush="{DynamicResource BorderWeakBrush}"
                                    BorderThickness="1" CornerRadius="10">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                        <ItemsControl x:Name="SearchUpcoming"
                                                      ItemTemplate="{StaticResource SearchRowTemplate}" />
                                        <Grid x:Name="SearchDivider" Height="26"
                                              Visibility="Collapsed">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Border Height="1" VerticalAlignment="Center"
                                                    Opacity="0.4"
                                                    Background="{DynamicResource BorderWeakBrush}" />
                                            <TextBlock Grid.Column="1" Text="已过期" Margin="8,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="{DynamicResource FontCaption}"
                                                       Foreground="{DynamicResource TextNoteBrush}" />
                                            <Border Grid.Column="2" Height="1" VerticalAlignment="Center"
                                                    Opacity="0.4"
                                                    Background="{DynamicResource BorderWeakBrush}" />
                                        </Grid>
                                        <ItemsControl x:Name="SearchExpired"
                                                      ItemTemplate="{StaticResource SearchRowTemplate}" />
                                        <TextBlock x:Name="SearchEmpty" Text="没有匹配的日程"
                                                   Margin="8"
                                                   FontSize="{DynamicResource FontBody}"
                                                   Foreground="{DynamicResource TextNoteBrush}"
                                                   Visibility="Collapsed" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0">
                        <Button x:Name="RefreshButton" Style="{StaticResource TitleBarIconButtonStyle}"
                                Margin="0,0,3,0"
                                ToolTip="刷新当前日程" Click="OnRefreshClick">
                            <Path Data="{StaticResource IconRefresh}"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  StrokeThickness="1.5" Stretch="Uniform"
                                  Width="14" Height="14" SnapsToDevicePixels="True" />
                        </Button>
                        <Button x:Name="PanelToggleButton" Style="{StaticResource TitleBarIconButtonStyle}"
                                ToolTip="收起右侧栏" Click="OnPanelToggleClick">
                            <Path x:Name="PanelToggleIcon" Data="{StaticResource IconPanelExpand}"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  StrokeThickness="1.5" Stretch="Uniform"
                                  Width="15.5" Height="15.5" SnapsToDevicePixels="True" />
                        </Button>
                        <Button Style="{StaticResource TitleBarIconButtonStyle}"
                                ToolTip="最小化" Click="OnMinimizeClick">
                            <Path Data="{StaticResource IconMinimize}"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  StrokeThickness="1.5" Stretch="Uniform"
                                  Width="13" Height="13" SnapsToDevicePixels="True" />
                        </Button>
                        <!-- 最大化 / 还原：两个 Path 都在 XAML 里，C# 只改 Tag 切换显示 -->
                        <Button x:Name="MaximizeButton" Style="{StaticResource TitleBarIconButtonStyle}"
                                ToolTip="最大化 / 还原" Click="OnMaximizeClick">
                            <Grid Width="13" Height="13">
                                <Path Data="{StaticResource IconMaximize}"
                                      Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                      StrokeThickness="1.5" Stretch="Uniform" SnapsToDevicePixels="True">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Tag}" Value="Maximized">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <Path Data="{StaticResource IconRestore}"
                                      Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                      StrokeThickness="1.5" Stretch="Uniform" SnapsToDevicePixels="True">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Tag}" Value="Maximized">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource TitleBarCloseButtonStyle}"
                                ToolTip="关闭到托盘" Click="OnCloseClick">
                            <Path Data="{StaticResource IconClose}"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  StrokeThickness="1.5" Stretch="Uniform"
                                  Width="13" Height="13" SnapsToDevicePixels="True" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ 主体 ============ -->
            <Grid Grid.Row="1" x:Name="BodyGrid" MouseLeftButtonDown="OnBodyMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="TodoPanelColumn" Width="0.32*" />
                </Grid.ColumnDefinitions>

                <!-- 左列小按键区（W=44）：创建 / 统计 / 视图 / 工具 / 设置 -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" Style="{StaticResource ToolButtonStyle}"
                            Margin="0,8,0,8" ToolTip="创建日程" Click="OnCreateClick">
                        <Path Data="{StaticResource IconCalendarPlus}"
                              Stroke="{DynamicResource IconStrokeBrush}"
                              StrokeThickness="1.5" Stretch="Uniform"
                              Width="16" Height="16" SnapsToDevicePixels="True" />
                    </Button>
                    <Button Grid.Row="4" Style="{StaticResource ToolButtonStyle}"
                            Margin="0,0,0,8" ToolTip="系统设置" Click="OnSettingsClick">
                        <!-- 图标线条色统一跟随「系统边框色」：与上方创建按钮同源（ADR-009），
                             避免两枚图标一橙一灰、常态观感不统一（用户反馈） -->
                        <Path Data="{StaticResource IconSettings}"
                              Stroke="{DynamicResource IconStrokeBrush}"
                              StrokeThickness="1.5" Stretch="Uniform"
                              Width="16" Height="16" SnapsToDevicePixels="True" />
                    </Button>
                    <!-- 月/周视图 -->
                    <Button x:Name="LooseButton" Grid.Row="2" Style="{StaticResource ToolButtonStyle}"
                            Margin="0,0,0,8" ToolTip="月/周视图" Click="OnToggleViewClick">
                        <!-- 严格按 SVG 的 24×24 viewBox / stroke-width=2 绘制；Viewbox 等比缩到 16×16，线宽随比例缩放 -->
                        <Viewbox Width="17" Height="17" Stretch="Uniform">
                            <Canvas Width="24" Height="24">
                                <Path x:Name="LooseIconPath"
                                      Data="{StaticResource IconLooseLayout}"
                                      Stroke="{DynamicResource IconStrokeBrush}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <!-- 统计数据：打开只读统计窗口 -->
                    <Button x:Name="StatisticsButton" Grid.Row="1" Style="{StaticResource ToolButtonStyle}"
                            Margin="0,0,0,8" VerticalAlignment="Top" ToolTip="统计数据"
                            Click="OnStatisticsClick">
                        <Path Data="{StaticResource IconChart}"
                              Stroke="{DynamicResource IconStrokeBrush}"
                              StrokeThickness="1.5" Stretch="Uniform"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Width="15" Height="15" SnapsToDevicePixels="True" />
                    </Button>
                    <!-- 小工具集合：点开右侧面板，格子由 ToolRegistry 注册项自动生成；图标取自 工具箱.svg -->
                    <Button x:Name="ToolBoxButton" Grid.Row="3" Style="{StaticResource ToolButtonStyle}"
                            Margin="0,0,0,8" VerticalAlignment="Top" ToolTip="小工具"
                            PreviewMouseLeftButtonDown="OnToolBoxPreviewMouseDown"
                            Click="OnToolBoxClick">
                        <Viewbox Width="17" Height="17" Stretch="Uniform">
                            <Canvas Width="24" Height="24">
                                <Path Data="M5 9 H19 A2 2 0 0 1 21 11 V18 A2 2 0 0 1 19 20 H5 A2 2 0 0 1 3 18 V11 A2 2 0 0 1 5 9 Z M8 9 V7 A2 2 0 0 1 10 5 H14 A2 2 0 0 1 16 7 V9 M3 13.5 H21"
                                      Stroke="{DynamicResource IconStrokeBrush}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <!-- 面板控件是 0×0 的空壳，只承载弹出层，放在同一行不影响布局 -->
                    <views:ToolBoxFlyout x:Name="ToolFlyout" Grid.Row="3"
                                         VerticalAlignment="Top" HorizontalAlignment="Left" />

                    <!-- 退出按钮：暂时隐藏（功能与代码保留，需要时删掉 Visibility 即可恢复） -->
                    <Button Grid.Row="6" Content="⏻" Style="{StaticResource ToolButtonStyle}"
                            Margin="0,0,0,14" ToolTip="退出程序" Click="OnExitClick" Visibility="Collapsed" />
                </Grid>

                <!-- 月历区 -->
                <Grid Grid.Column="1" x:Name="MonthView">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="42" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 第一行：年份（居中 20px SemiBold，左右切换按钮） -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="PrevYearButton" Grid.Column="0" Content="◀"
                                HorizontalAlignment="Right" Margin="0,0,16,0"
                                Style="{StaticResource NavButtonStyle}" Click="OnPrevYearClick" />
                        <TextBlock x:Name="YearText" Grid.Column="1" Text="2026 年"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="{DynamicResource FontH1}" FontWeight="SemiBold"
                                   FontFamily="{DynamicResource AppFont}"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Button x:Name="NextYearButton" Grid.Column="2" Content="▶"
                                HorizontalAlignment="Left" Margin="16,0,0,0"
                                Style="{StaticResource NavButtonStyle}" Click="OnNextYearClick" />
                    </Grid>

                    <!-- 第二行：月份（居中 18px SemiBold，左右切换按钮） -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="PrevMonthButton" Grid.Column="0" Content="◀"
                                HorizontalAlignment="Right" Margin="0,0,16,0"
                                Style="{StaticResource NavButtonStyle}" Click="OnPrevMonthClick" />
                        <TextBlock x:Name="MonthText" Grid.Column="1" Text="9 月"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="{DynamicResource FontH2}" FontWeight="SemiBold"
                                   FontFamily="{DynamicResource AppFont}"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Button x:Name="NextMonthButton" Grid.Column="2" Content="▶"
                                HorizontalAlignment="Left" Margin="16,0,0,0"
                                Style="{StaticResource NavButtonStyle}" Click="OnNextMonthClick" />
                    </Grid>

                    <!-- 第三行：星期表头（周一 ~ 周日） -->
                    <UniformGrid Grid.Row="2" Columns="7">
                        <TextBlock Text="一" Style="{StaticResource WeekdayHeaderStyle}" />
                        <TextBlock Text="二" Style="{StaticResource WeekdayHeaderStyle}" />
                        <TextBlock Text="三" Style="{StaticResource WeekdayHeaderStyle}" />
                        <TextBlock Text="四" Style="{StaticResource WeekdayHeaderStyle}" />
                        <TextBlock Text="五" Style="{StaticResource WeekdayHeaderStyle}" />
                        <TextBlock Text="六" Style="{StaticResource WeekdayHeaderStyle}" />
                        <TextBlock Text="日" Style="{StaticResource WeekdayHeaderStyle}" />
                    </UniformGrid>

                    <!-- 第四行：42 格月历（6 行 × 7 列，跨月显示） -->
                    <ItemsControl x:Name="CalendarItems" Grid.Row="3">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7" Rows="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="1">
                                    <Border Padding="5"
                                            MouseEnter="OnCellMouseEnter"
                                            MouseLeave="OnCellMouseLeave"
                                            MouseLeftButtonDown="OnCellMouseLeftButtonDown"
                                            MouseRightButtonDown="OnCellMouseRightButtonDown">
                                        <Border.Opacity>
                                            <Binding Path="IsCurrentMonth" Converter="{StaticResource OtherMonthOpacity}" />
                                        </Border.Opacity>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <!-- 普通边框由下方独立覆盖层绘制；这里只保留选中态的 2px 焦点边框。 -->
                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Setter Property="CornerRadius" Value="3" />
                                                <!-- 仅「邻月」整格显淡（由 Opacity 处理）；当月内的过往 / 未来日期同色。 -->
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                        <!-- 今日仍保留原来的 1px 普通边框；2px 今日边框由上方覆盖层绘制。
                                                             渐变光晕仍画在背景层作为顶部高光。 -->
                                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderWeakBrush}" />
                                                        <Setter Property="Background" Value="{DynamicResource TodayGlowBrush}" />
                                                    </DataTrigger>
                                                    <!-- 单击选中：用焦点边框色常驻高亮（置于 IsToday 之后，选中态优先） -->
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="新建日程" Click="OnCellCreateClick" />
                                            <MenuItem Header="打开该日" Click="OnCellOpenClick" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="20" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <!-- 日期号（左上，今日 = 22×22 实心圆 + 白字） + 右上小字 -->
                                        <Grid Grid.Row="0">
                                            <Grid HorizontalAlignment="Left" VerticalAlignment="Center"
                                                  Width="22" Height="22">
                                                <Ellipse Width="22" Height="22" Fill="{DynamicResource TodayBorderBrush}">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding DayText}" Style="{StaticResource DayNumberStyle}" />
                                            </Grid>
                                            <TextBlock Text="{Binding SubText}" Style="{StaticResource SubLabelStyle}" />
                                        </Grid>

                                        <!-- 日程区：显示条数按「格子实际高度」动态计算，放不下时在底部显示「+N」（OPT-023）。
                                             ClipToBounds 保证多余行被裁掉，不会盖到相邻格。
                                             Tag="ScheduleArea" 是给代码用的量测锚点：代码直接读它的实际高度，
                                             不再靠「格子总高 − 常量」去推算（见 MainWindow.xaml.cs 的 MeasureScheduleAreaHeight）。 -->
                                        <StackPanel Grid.Row="1" Margin="0,1,0,0" ClipToBounds="True" Tag="ScheduleArea">
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Height="14" CornerRadius="4" Padding="3,0"
                                                                Background="{Binding BgColor, Converter={StaticResource ScheduleBg}}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding TimeText}"
                                                                           FontSize="{DynamicResource FontBodyS}"
                                                                           FontFamily="{DynamicResource AppFont}"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{Binding FontColor, Converter={StaticResource ScheduleFont}}" />
                                                                <!-- OPT-023：不再按字数硬截断，直接绑标题，
                                                                     由下面的 TextTrimming 按格子实际可用宽度自适应（统一用原生「…」） -->
                                                                <TextBlock Grid.Column="1" Margin="4,0,0,0"
                                                                           Text="{Binding TitleText}"
                                                                           FontSize="{DynamicResource FontBodyS}"
                                                                           FontFamily="{DynamicResource AppFont}"
                                                                           VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Foreground="{Binding FontColor, Converter={StaticResource ScheduleFont}}" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <!-- OPT-023：由固定的「......」改为「+N」（N = 实际未显示的条数），
                                                 仅当真的放不下时才出现 -->
                                            <TextBlock Text="{Binding MoreText}" Height="14"
                                                       FontSize="{DynamicResource FontBodyS}"
                                                       FontFamily="{DynamicResource AppFont}"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>

                                        <!-- 未完成待办角标：B 方案，固定锚定 22×22 日期数字槽右上角；
                                             X = 22（槽宽）− 12（角标宽）+ 6（右溢出）= 16 -->
                                        <Border Grid.RowSpan="2" Panel.ZIndex="10"
                                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                                Width="12" Height="12" CornerRadius="6"
                                                Margin="13,-4,0,0" Background="#FF6B6B"
                                                Visibility="{Binding HasTodoPending, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{Binding TodoBadgeText}" FontSize="7.5"
                                                       Foreground="#FFF2F2F2"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- 普通月格 1px 边框覆盖层：只影响边框，不淡日期/日程内容。
                                     当月 0.4，邻月 0.16；选中与今日边框保持原样。 -->
                                <Border BorderBrush="{DynamicResource BorderWeakBrush}"
                                        BorderThickness="1" CornerRadius="3"
                                        Background="Transparent" IsHitTestVisible="False">
                                    <Border.Opacity>
                                        <Binding Path="IsCurrentMonth" Converter="{StaticResource MonthBorderOpacity}" />
                                    </Border.Opacity>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <!-- 今日 2px 边框只做覆盖层，不参与布局，不挤压内容高度；选中时隐藏。 -->
                                <Border BorderBrush="{DynamicResource TodayBorderBrush}"
                                        BorderThickness="2" CornerRadius="3"
                                        Background="Transparent" IsHitTestVisible="False">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsToday}" Value="True" />
                                                        <Condition Binding="{Binding IsSelected}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <!-- ============ 周视图（宽松布局） ============ -->
                <Grid Grid.Column="1" x:Name="WeekView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="42" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 月份行：跨月周两个月并列；左右箭头 = 上一月 / 下一月（跳到目标月 1 日所在周） -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="WeekPrevMonthButton" Grid.Column="0" Content="◀"
                                HorizontalAlignment="Right" Margin="0,0,16,0"
                                ToolTip="上一月" Style="{StaticResource NavButtonStyle}"
                                Click="OnWeekPrevMonthClick" />
                        <TextBlock x:Name="WeekMonthText" Grid.Column="1"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="{DynamicResource FontH1}" FontWeight="SemiBold"
                                   FontFamily="{DynamicResource AppFont}"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Button x:Name="WeekNextMonthButton" Grid.Column="2" Content="▶"
                                HorizontalAlignment="Left" Margin="16,0,0,0"
                                ToolTip="下一月" Style="{StaticResource NavButtonStyle}"
                                Click="OnWeekNextMonthClick" />
                    </Grid>

                    <!-- 日期范围行：◀ 12日 – 18日 ▶ -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="PrevWeekButton" Grid.Column="0" Content="◀"
                                HorizontalAlignment="Right" Margin="0,0,16,0"
                                Style="{StaticResource NavButtonStyle}" Click="OnPrevWeekClick" />
                        <TextBlock x:Name="WeekRangeText" Grid.Column="1"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="{DynamicResource FontH2}" FontWeight="SemiBold"
                                   FontFamily="{DynamicResource AppFont}"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Button x:Name="NextWeekButton" Grid.Column="2" Content="▶"
                                HorizontalAlignment="Left" Margin="16,0,0,0"
                                Style="{StaticResource NavButtonStyle}" Click="OnNextWeekClick" />
                    </Grid>

                    <!-- 星期行：48px 时间轴占位 + 7 天，与主体列严格对齐 -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="一" Style="{StaticResource WeekdayHeaderStyle}" />
                        <TextBlock Grid.Column="2" Text="二" Style="{StaticResource WeekdayHeaderStyle}" />
                        <TextBlock Grid.Column="3" Text="三" Style="{StaticResource WeekdayHeaderStyle}" />
                        <TextBlock Grid.Column="4" Text="四" Style="{StaticResource WeekdayHeaderStyle}" />
                        <TextBlock Grid.Column="5" Text="五" Style="{StaticResource WeekdayHeaderStyle}" />
                        <TextBlock Grid.Column="6" Text="六" Style="{StaticResource WeekdayHeaderStyle}" />
                        <TextBlock Grid.Column="7" Text="日" Style="{StaticResource WeekdayHeaderStyle}" />
                    </Grid>

                    <!-- 主体：8 列（48 + 7 天），2 行（日期头 44 + 日程区）。
                         每列的 Border 跨两行，日期头和日程区共用同一条列边框。 -->
                    <Grid Grid.Row="3" x:Name="WeekBody" SizeChanged="OnWeekSizeChanged" ClipToBounds="False"
                          UseLayoutRounding="True" SnapsToDevicePixels="True">
                        <!-- 15 列：48px 时间轴 + 7 个 1px 分隔列 + 7 个日期列。
                             分隔线是真实布局列，窗口/面板/界面缩放时不会像 Canvas 绝对坐标那样错位。 -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="44" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Canvas x:Name="WeekAxis" Grid.Column="0" Grid.Row="1" ClipToBounds="True" />
                    </Grid>
                </Grid>

                <!-- ============ 右侧「当日待办事项」面板 ============ -->
                <Border Grid.Column="2" x:Name="TodoPanel"
                        Background="Transparent"
                        BorderBrush="{DynamicResource BorderWeakBrush}" BorderThickness="1,0,0,0"
                        ClipToBounds="True">
                    <Border.Resources>
                        <DataTemplate x:Key="TodoRowTemplate">
                            <Grid Margin="0,1" MinHeight="28"
                                  Background="{Binding BgColor, Converter={StaticResource ScheduleBg}}">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                <Setter Property="Opacity" Value="0.5" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="45" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsDone, Mode=TwoWay}"
                                          Style="{StaticResource ScheduleCheckBoxStyle}"
                                          Tag="{Binding CheckBrush}"
                                          Background="{Binding HoverBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Checked="OnTodoChecked" Unchecked="OnTodoUnchecked" />
                                <TextBlock Grid.Column="1" Text="{Binding TimeText}"
                                           FontSize="{DynamicResource FontBodyS}"
                                           FontFamily="{DynamicResource AppFont}"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding FontColor, Converter={StaticResource ScheduleFont}}" />
                                <TextBlock Grid.Column="2" Text="{Binding TitleText}"
                                           FontSize="{DynamicResource FontBody}"
                                           FontFamily="{DynamicResource AppFont}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{Binding FontColor, Converter={StaticResource ScheduleFont}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextNoteBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>

                        <!-- 当日日程独立模板：只影响「当日日程」分区，不再和待办行共用高度 -->
                        <DataTemplate x:Key="ScheduleRowTemplate">
                            <Grid Margin="0,1" MinHeight="28"
                                  Background="{Binding BgColor, Converter={StaticResource ScheduleBg}}">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                <Setter Property="Opacity" Value="0.5" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="45" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsDone, Mode=TwoWay}"
                                          Style="{StaticResource ScheduleCheckBoxStyle}"
                                          Tag="{Binding CheckBrush}"
                                          Background="{Binding HoverBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Checked="OnTodoChecked" Unchecked="OnTodoUnchecked" />
                                <TextBlock Grid.Column="1" Text="{Binding TimeText}"
                                           FontSize="{DynamicResource FontBodyS}"
                                           FontFamily="{DynamicResource AppFont}"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding FontColor, Converter={StaticResource ScheduleFont}}" />
                                <TextBlock Grid.Column="2" Text="{Binding TitleText}"
                                           FontSize="{DynamicResource FontBody}"
                                           FontFamily="{DynamicResource AppFont}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{Binding FontColor, Converter={StaticResource ScheduleFont}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextNoteBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </Border.Resources>

                    <ScrollViewer Margin="14,12,12,12" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- 面板标题：选中日期 + 农历 / 节假日 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="PanelDateText"
                                           FontSize="{DynamicResource FontH2}" FontWeight="SemiBold"
                                           FontFamily="{DynamicResource AppFont}"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock x:Name="PanelSubText" Grid.Column="1"
                                           Margin="8,0,0,0" VerticalAlignment="Center"
                                           FontSize="{DynamicResource FontBody}"
                                           FontFamily="{DynamicResource AppFont}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>

                            <!-- 待办事项 -->
                            <Grid Margin="0,24,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="待办事项"
                                           FontSize="{DynamicResource FontBodyL}" FontWeight="SemiBold"
                                           FontFamily="{DynamicResource AppFont}"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock x:Name="TodoCountText" Grid.Column="1"
                                           FontSize="{DynamicResource FontBody}"
                                           FontFamily="{DynamicResource AppFont}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>
                            <ItemsControl x:Name="TodoItems" ItemTemplate="{StaticResource TodoRowTemplate}" />
                            <TextBlock x:Name="TodoEmptyHint" Text="（当日无待办事项）"
                                       FontSize="{DynamicResource FontBody}" FontFamily="{DynamicResource AppFont}"
                                       Foreground="{DynamicResource TextNoteBrush}" Margin="0,4" Visibility="Collapsed" />

                            <Border Height="1" Background="{DynamicResource BorderWeakBrush}" Margin="0,14" />

                            <!-- 当日日程（普通日程，非待办） -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="当日日程"
                                           FontSize="{DynamicResource FontBodyL}" FontWeight="SemiBold"
                                           FontFamily="{DynamicResource AppFont}"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock x:Name="ScheduleCountText" Grid.Column="1"
                                           FontSize="{DynamicResource FontBody}"
                                           FontFamily="{DynamicResource AppFont}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>
                            <ItemsControl x:Name="ScheduleItems" ItemTemplate="{StaticResource ScheduleRowTemplate}" />
                            <TextBlock x:Name="ScheduleEmptyHint" Text="（当日无日程）"
                                       FontSize="{DynamicResource FontBody}" FontFamily="{DynamicResource AppFont}"
                                       Foreground="{DynamicResource TextNoteBrush}" Margin="0,4" Visibility="Collapsed" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ============ 右下角缩放 grip ============ -->
            <Border Grid.Row="1" Width="16" Height="16" Background="Transparent"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,2,2" Cursor="SizeNWSE"
                    MouseLeftButtonDown="OnResizeGripMouseLeftButtonDown">
                <Path Data="M14,3 L3,14 M14,8 L8,14"
                      Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Grid>
    </Border>
</Window>
