<Window x:Class="ScheduleReminder.Views.TagTemplateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="标签"
        Width="275" Height="290"
        MinWidth="275" MinHeight="290"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        Background="Transparent" ShowInTaskbar="True" UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                            GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 计数（0/6）：与「新建日程」一致 -->
        <Style x:Key="CounterText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextNoteBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <!-- 字段标签：13px 主文字色（与「新建日程」同款 FieldLabel13） -->
        <Style x:Key="FieldLabel13" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>


        <!-- 底栏主按钮：120×40、15px（对齐「新建日程」） -->
        <Style x:Key="OutlineButton" TargetType="Button" BasedOn="{StaticResource NormalButtonStyle}">
            <Setter Property="Width" Value="80" />
            <Setter Property="Height" Value="24" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <Border CornerRadius="12"
            Background="{DynamicResource WindowBgBrush}"
            BorderBrush="{DynamicResource BorderWeakBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="24" />
                <RowDefinition Height="*" />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>

            <!-- ============ 标题栏 H=34 ============ -->
            <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid>
                    <TextBlock x:Name="TitleText" Text="新建标签" Margin="16,0,60,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               FontSize="13" FontWeight="SemiBold"
                               FontFamily="{DynamicResource AppFont}"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <Button HorizontalAlignment="Right" Margin="0,0,6,0"
                            Style="{StaticResource TitleBarCloseButtonStyle}" Click="OnCancelClick">
                        <Path Data="{StaticResource IconClose}"
                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                              StrokeThickness="1.5" Stretch="Uniform"
                              Width="13" Height="13" SnapsToDevicePixels="True" />
                    </Button>
                </Grid>
            </Border>

            <!-- ============ 内容区 ============ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,16,24,16">

                    <!-- 标签名（6 字上限：超出自动截断，含粘贴；标签要能塞进日程条） -->
                    <Grid>
                        <TextBlock Text="标签名（必填）" Style="{StaticResource FieldLabel13}" HorizontalAlignment="Left" />
                        <TextBlock x:Name="NameCounter" Text="0/6" Style="{StaticResource CounterText}" />
                    </Grid>
                    <TextBox x:Name="NameBox" Height="32" MaxLength="6" Margin="0,2,0,0"
                             Style="{StaticResource InputBoxStyle}"
                             TextChanged="OnNameTextChanged" />

                    <!-- 背景颜色 | 字体颜色（各带一枚次级小按钮：
                         「默认」= 背景透明（取色弹窗无透明选项，透明语义由此按钮承载）；
                         「默认」= 字体颜色回归系统文字颜色（等价于「未单独设置」）） -->
                    <Grid Margin="0,16,0,0">
                        <TextBlock Text="背景颜色" Style="{StaticResource FieldLabel13}" HorizontalAlignment="Left" />
                        <TextBlock Text="字体颜色" Style="{StaticResource FieldLabel13}" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,2,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button x:Name="BgSwatch" Width="62" Height="32"
                                    Style="{StaticResource NormalButtonStyle}"
                                    Cursor="Hand" Click="OnBgColorClick">
                                <Rectangle x:Name="BgRect" Width="54" Height="24" RadiusX="3" RadiusY="3"
                                           Fill="{StaticResource CheckerBrush}" />
                            </Button>
                            <Button Content="默认" Width="36" Height="32" Margin="4,0,0,0"
                                    Style="{StaticResource NormalButtonStyle}"
                                    FontSize="11" Cursor="Hand"
                                    ToolTip="默认透明" Click="OnBgTransparentClick" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="FontSwatch" Width="62" Height="32"
                                    Style="{StaticResource NormalButtonStyle}"
                                    Cursor="Hand" Click="OnFontColorClick">
                                <Rectangle x:Name="FontRect" Width="54" Height="24" RadiusX="3" RadiusY="3"
                                           Fill="{StaticResource CheckerBrush}" />
                            </Button>
                            <Button Content="默认" Width="36" Height="32" Margin="4,0,0,0"
                                    Style="{StaticResource NormalButtonStyle}"
                                    FontSize="11" Cursor="Hand"
                                    ToolTip="跟随系统设置" Click="OnFontFollowSystemClick" />
                        </StackPanel>
                    </Grid>
                    <!-- 提醒铃：复用现成的音效下拉装配逻辑（SoundPicker），与系统设置 / 新建日程一致 -->
                    <TextBlock Text="提醒铃" Style="{StaticResource FieldLabel13}" Margin="0,16,0,0" />
                    <ComboBox x:Name="SoundCombo" Height="32" Margin="0,2,0,0"
                              HorizontalAlignment="Stretch" Style="{StaticResource MaterialCombo}" />

                </StackPanel>
            </ScrollViewer>

            <!-- ============ 底栏：仅 保存 / 取消，水平居中 ============ -->
            <Border Grid.Row="2" BorderBrush="{DynamicResource BorderWeakBrush}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="保存" Style="{StaticResource OutlineButton}" Click="OnSaveClick" />
                    <Button Content="取消" Style="{StaticResource OutlineButton}"
                            Margin="12,0,0,0" Click="OnCancelClick" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>