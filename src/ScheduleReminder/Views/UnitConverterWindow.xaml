<Window x:Class="ScheduleReminder.Views.UnitConverterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="单位换算"
        Width="400" Height="440" MinWidth="360" MinHeight="400"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResize"
        Background="Transparent" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <!-- 自绘无边框窗口：CaptionHeight=0（拖动由代码 DragMove 完成），四边 6px 交给 WindowChrome 做缩放命中 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 字段标签：宽 48、12 像素、弱提示文字色 -->
        <Style x:Key="ToolFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Width" Value="48" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="{DynamicResource FontBody}" />
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
            <Setter Property="Foreground" Value="{DynamicResource TextNoteBrush}" />
        </Style>

        <!-- 数值输入框外壳：高 26、圆角走主程序 RadiusInput；内部 TextBox 去边框 -->
        <Style x:Key="ToolInputShellStyle" TargetType="Border">
            <Setter Property="Height" Value="26" />
            <Setter Property="Background" Value="{DynamicResource BgInputBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderWeakBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusInput}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- 窗口四周留 20 像素透明边距，用来承载投影；可见内容区为 360×400 -->
    <Grid>
        <Border Margin="20" CornerRadius="{DynamicResource RadiusWindow}"
                Background="{DynamicResource WindowBgSolidBrush}"
                BorderBrush="{DynamicResource BorderWeakBrush}" BorderThickness="1"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <!-- 原型：0 18px 60px rgba(0,0,0,0.55) -->
                <DropShadowEffect Color="Black" Direction="90" ShadowDepth="18" BlurRadius="60" Opacity="0.55" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <!-- 标题栏 34：与主程序各窗口一致（TitleBarHeight（标题栏高度）是 Double，不能用于 RowDefinition.Height） -->
                    <RowDefinition Height="34" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ============ 标题栏（无图标，仅程序名，左定位 12） ============ -->
                <Border Grid.Row="0" Background="Transparent"
                        MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                    <Grid>
                        <TextBlock Text="单位换算" Margin="12,0,0,0"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   FontSize="13" FontWeight="SemiBold"
                                   FontFamily="{DynamicResource AppFont}"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0">
                            <Button Style="{StaticResource TitleBarIconButtonStyle}"
                                    ToolTip="最小化" Click="OnMinimizeClick">
                                <Path Data="{StaticResource IconMinimize}"
                                      Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                      StrokeThickness="1.5" Stretch="Uniform"
                                      Width="13" Height="13" SnapsToDevicePixels="True" />
                            </Button>
                            <Button Style="{StaticResource TitleBarCloseButtonStyle}"
                                    ToolTip="关闭" Click="OnCloseClick">
                                <Path Data="{StaticResource IconClose}"
                                      Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                      StrokeThickness="1.5" Stretch="Uniform"
                                      Width="13" Height="13" SnapsToDevicePixels="True" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============ 主体：上 2、左右 18、下 6 ============ -->
                <Grid Grid.Row="1" Margin="18,2,18,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />   <!-- 类别行 -->
                        <RowDefinition Height="Auto" />   <!-- 数值行 -->
                        <RowDefinition Height="*" />      <!-- 结果列表 -->
                    </Grid.RowDefinitions>

                    <!-- 类别行：上外边距 8，标签 48，下拉宽 120 -->
                    <Grid Grid.Row="0" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="类别" Style="{StaticResource ToolFieldLabelStyle}" />
                        <ComboBox Grid.Column="1" x:Name="CategoryBox" Width="120" Height="26"
                                  HorizontalAlignment="Left"
                                  Style="{StaticResource ComboStyle}"
                                  DisplayMemberPath="Name"
                                  SelectionChanged="OnCategoryChanged" />
                    </Grid>

                    <!-- 数值行：上外边距 8，输入框占满，单位下拉宽 110、左间距 8 -->
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="数值" Style="{StaticResource ToolFieldLabelStyle}" />

                        <Border Grid.Column="1" Style="{StaticResource ToolInputShellStyle}">
                            <TextBox x:Name="ValueBox"
                                     Background="Transparent" BorderThickness="0"
                                     Padding="12,0,12,0"
                                     VerticalContentAlignment="Center"
                                     FontSize="{DynamicResource FontBody}"
                                     FontFamily="{DynamicResource AppFont}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     CaretBrush="{DynamicResource TextPrimaryBrush}"
                                     TextChanged="OnValueTextChanged"
                                     PreviewTextInput="OnValuePreviewTextInput"
                                     DataObject.Pasting="OnValuePasting" />
                        </Border>

                        <ComboBox Grid.Column="2" x:Name="UnitBox" Width="110" Height="26"
                                  Margin="8,0,0,0"
                                  Style="{StaticResource ComboStyle}"
                                  DisplayMemberPath="Name"
                                  SelectionChanged="OnUnitChanged" />
                    </Grid>

                    <!-- 结果列表：上外边距 10，圆角走主程序 RadiusRow，一圈弱边框，可纵向滚动 -->
                    <!-- ClipToBounds：原型 .result 是 overflow-y:auto（非 visible），内容须被圆角容器裁住 -->
                    <Border Grid.Row="2" Margin="0,10,0,0"
                            CornerRadius="{DynamicResource RadiusRow}"
                            BorderBrush="{DynamicResource BorderWeakBrush}" BorderThickness="1"
                            SnapsToDevicePixels="True" ClipToBounds="True">
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="ResultList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- 行高 28、左右内边距 12；左侧单位名宽 90，右侧数值右对齐等宽 -->
                                            <Grid Height="28" Margin="12,0,12,0">
                                                <!-- 悬停背景只能由样式触发器给出：写成元素属性会因依赖属性优先级压死触发器 -->
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background"
                                                                        Value="{DynamicResource BgHoverBrush}" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding UnitName}"
                                                           VerticalAlignment="Center"
                                                           FontSize="{DynamicResource FontBody}"
                                                           FontFamily="{DynamicResource AppFont}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding ValueText}"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Right" TextAlignment="Right"
                                                           FontSize="{DynamicResource FontBody}"
                                                           FontFamily="{DynamicResource MonoFont}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- 空输入占位：原型为「输入数值后显示换算结果」 -->
                            <TextBlock x:Name="PlaceholderText"
                                       Text="输入数值后显示换算结果"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="{DynamicResource FontBodyS}"
                                       FontFamily="{DynamicResource AppFont}"
                                       Foreground="{DynamicResource TextNoteBrush}"
                                       Visibility="Collapsed" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
