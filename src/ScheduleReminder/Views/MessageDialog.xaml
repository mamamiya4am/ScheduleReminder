<Window x:Class="ScheduleReminder.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提示"
        Width="360" SizeToContent="Height" MinHeight="150" MaxHeight="420"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        Background="Transparent" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <Border CornerRadius="{DynamicResource RadiusWindow}"
            Background="{DynamicResource WindowBgBrush}"
            BorderBrush="{DynamicResource BorderWeakBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="*" />
                <RowDefinition Height="52" />
            </Grid.RowDefinitions>

            <!-- 标题栏（带左上角关闭按钮） -->
            <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid>
                    <TextBlock x:Name="TitleText" Text="提示" Margin="14,0,0,0"
                               VerticalAlignment="Center" FontSize="{DynamicResource FontBody}"
                               FontFamily="{DynamicResource AppFont}"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <Button HorizontalAlignment="Right" Margin="0,0,6,0"
                            Style="{StaticResource TitleBarCloseButtonStyle}" Click="OnCloseClick">
                        <Path Data="{StaticResource IconClose}"
                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                              StrokeThickness="1.5" Stretch="Uniform"
                              Width="13" Height="13" SnapsToDevicePixels="True" />
                    </Button>
                </Grid>
            </Border>

            <!-- 正文 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="16,4,16,4">
                <TextBlock x:Name="MessageText" Text="" TextWrapping="Wrap"
                           FontSize="{DynamicResource FontBody}"
                           FontFamily="{DynamicResource AppFont}"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
            </ScrollViewer>

            <!-- 底部按钮 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,16,0">
                <Button x:Name="CancelButton" Content="取消" Width="70" Height="26" Margin="0,0,8,0"
                        Style="{StaticResource NormalButtonStyle}" Click="OnCancelClick" />
                <Button x:Name="OkButton" Content="确定" Width="70" Height="26"
                        Style="{StaticResource NormalButtonStyle}" Click="OnOkClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
