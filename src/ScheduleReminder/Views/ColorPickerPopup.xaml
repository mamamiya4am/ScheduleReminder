<Window x:Class="ScheduleReminder.Views.ColorPickerPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择颜色"
        Width="300" SizeToContent="Height" MaxHeight="560"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        Background="Transparent" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True" SnapsToDevicePixels="True"
        KeyDown="OnWindowKeyDown">

    <Window.Resources>
        <!-- 色块按钮：36×36，圆角 6，本体即纯色块 -->
        <Style x:Key="SwatchButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource RadiusButton}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="{DynamicResource RadiusWindow}"
            Background="{DynamicResource WindowBgBrush}"
            BorderBrush="{DynamicResource BorderWeakBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="52" />
            </Grid.RowDefinitions>

            <!-- ============ 自绘标题栏 ============ -->
            <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="选择颜色" Margin="14,0,0,0" VerticalAlignment="Center"
                               FontSize="{DynamicResource FontBody}"
                               FontFamily="{DynamicResource AppFont}"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <Button HorizontalAlignment="Right" Margin="0,0,6,0"
                            Style="{StaticResource TitleBarCloseButtonStyle}" Click="OnCloseClick">
                        <Path Data="{StaticResource IconClose}"
                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                              StrokeThickness="1.5" Stretch="Uniform"
                              Width="13" Height="13" SnapsToDevicePixels="True" />
                    </Button>
                </Grid>
            </Border>

            <!-- ============ 预设色 + 自定义色 ============ -->
            <StackPanel Grid.Row="1" Margin="16,4,16,8">
                <TextBlock Text="预设颜色" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4" />
                <WrapPanel x:Name="PresetPanel" />

                <TextBlock Text="自定义颜色（左键取色 / 应用 · 右键替换）"
                           Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,4" />
                <WrapPanel x:Name="CustomPanel" />

                <TextBlock Text="空框：左键弹系统取色器取色并存入；已存框：左键应用、右键替换"
                           Style="{StaticResource HintTextStyle}" />
            </StackPanel>

            <!-- ============ 底部按钮 ============ -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,16,0">
                <Button Content="取消" Width="70" Height="26"
                        Style="{StaticResource NormalButtonStyle}" Click="OnCancelClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
