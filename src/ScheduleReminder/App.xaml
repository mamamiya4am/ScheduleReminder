<Application x:Class="ScheduleReminder.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Icons.xaml" />
                <ResourceDictionary Source="Resources/StatisticsPalette.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ============ 字体 ============ -->
            <FontFamily x:Key="AppFont">Microsoft YaHei UI, Microsoft YaHei, PingFang SC, Segoe UI</FontFamily>
            <FontFamily x:Key="MonoFont">Consolas, Microsoft YaHei UI, Segoe UI</FontFamily>

            <system:Double x:Key="FontH1">20</system:Double>
            <system:Double x:Key="FontH2">18</system:Double>
            <system:Double x:Key="FontH3L">16</system:Double>
            <system:Double x:Key="FontH3">15</system:Double>
            <system:Double x:Key="FontBodyL">14</system:Double>
            <system:Double x:Key="FontBody">12</system:Double>
            <system:Double x:Key="FontBodyS">11</system:Double>
            <system:Double x:Key="FontCaption">9.5</system:Double>

            <!-- ============ 尺寸 / 圆角 ============ -->
            <CornerRadius x:Key="RadiusWindow">12</CornerRadius>
            <CornerRadius x:Key="RadiusButton">6</CornerRadius>
            <CornerRadius x:Key="RadiusInput">6</CornerRadius>
            <CornerRadius x:Key="RadiusChip">4</CornerRadius>
            <CornerRadius x:Key="RadiusRow">7</CornerRadius>

            <system:Double x:Key="TitleBarHeight">34</system:Double>
            <system:Double x:Key="WindowPadding">16</system:Double>
            <system:Double x:Key="CellPadding">6</system:Double>

            <!-- ============ 配色 Token ============ -->
            <!-- 说明：所有颜色均以 SolidColorBrush 形式提供，ThemeService 会在运行时整体替换这些画笔。 -->
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F2F2" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A8A8AE" />
            <SolidColorBrush x:Key="TextPastBrush" Color="#6E6E6E" />
            <SolidColorBrush x:Key="TextDangerBrush" Color="#FF6B6B" />
            <SolidColorBrush x:Key="TextNoteBrush" Color="#8A8A8A" />

            <SolidColorBrush x:Key="BorderWeakBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="BorderStrongBrush" Color="#38FFFFFF" />
            <SolidColorBrush x:Key="TodayBorderBrush" Color="#FFFFA726" />
            <!-- 今日圆点上的日期数字色（黑 / 白）：ThemeService 启动时按「今日色」亮度自动覆盖此值 -->
            <SolidColorBrush x:Key="TodayOnColorBrush" Color="#FF101012" />
            <!-- 今日高亮「线性渐变」高亮（顶部 35% 峰值、向下渐隐）；ThemeService 启动时会按设置覆盖此值 -->
            <LinearGradientBrush x:Key="TodayGlowBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#59FFA726" Offset="0.0" />
                <GradientStop Color="#00FFA726" Offset="0.1" />
                <GradientStop Color="#00FFA726" Offset="1.0" />
            </LinearGradientBrush>
            <!-- 周历今日列单独使用 0.05 的渐隐终点；月历仍使用 TodayGlowBrush 的 0.1。 -->
            <LinearGradientBrush x:Key="WeekTodayGlowBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#59FFA726" Offset="0.0" />
                <GradientStop Color="#00FFA726" Offset="0.05" />
                <GradientStop Color="#00FFA726" Offset="1.0" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="AccentBrush" Color="#FF6C8CFF" />
            <!-- 焦点 / 悬停边框色：可在设置窗「焦点边框颜色」中修改；ThemeService 启动时会按设置覆盖此值 -->
            <SolidColorBrush x:Key="FocusBorderBrush" Color="#FF6C8CFF" />

            <SolidColorBrush x:Key="WindowBgBrush" Color="#FF101012" />
            <!-- 提醒浮层专用底色：不透明，永远不受「背景透明度」设置影响 -->
            <SolidColorBrush x:Key="PopupBgBrush" Color="#F2101012" />
            <SolidColorBrush x:Key="BgPastCellBrush" Color="#08FFFFFF" />
            <SolidColorBrush x:Key="BgHoverBrush" Color="#24FFFFFF" />
            <SolidColorBrush x:Key="BgInputBrush" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="BgBtnBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="BgDangerHoverBrush" Color="#2EFF6B6B" />

            <!-- 控件填充色（按钮 / 输入框 / 下拉框底色），可在设置窗「控件填充色」中修改 -->
            <SolidColorBrush x:Key="ControlFillBrush" Color="#14FFFFFF" />

            <!-- 透明棋盘格（用于「透明」色块与默认取色控件本体） -->
            <DrawingBrush x:Key="CheckerBrush" TileMode="Tile"
                          Viewport="0,0,8,8" ViewportUnits="Absolute"
                          Viewbox="0,0,8,8" ViewboxUnits="Absolute">
                <DrawingBrush.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="#FF2A2A2E">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0,0,8,8" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="#FF4A4A52">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0,0,4,4" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="#FF4A4A52">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="4,4,4,4" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>

            <!-- 日程色板 C1~C23，供取色弹窗直接引用；取色弹窗按 PaletteC 前缀自动发现，新增颜色只需在此追加 -->
            <SolidColorBrush x:Key="PaletteC1" Color="#FFFF6B6B" />
            <SolidColorBrush x:Key="PaletteC2" Color="#FF4ECDC4" />
            <SolidColorBrush x:Key="PaletteC3" Color="#FFFFD93D" />
            <SolidColorBrush x:Key="PaletteC4" Color="#FF6C8CFF" />
            <SolidColorBrush x:Key="PaletteC5" Color="#FFB388FF" />
            <SolidColorBrush x:Key="PaletteC6" Color="#FFFF9F45" />
            <SolidColorBrush x:Key="PaletteC7" Color="#FFFF8FB3" />
            <SolidColorBrush x:Key="PaletteC8" Color="#FF7CE38B" />
            <SolidColorBrush x:Key="PaletteC9" Color="#FF5AC8FA" />
            <SolidColorBrush x:Key="PaletteC10" Color="#FFC0C0C8" />
            <SolidColorBrush x:Key="PaletteC11" Color="#FFE57373" />
            <SolidColorBrush x:Key="PaletteC12" Color="#FF4DB6AC" />
            <SolidColorBrush x:Key="PaletteC13" Color="#FFF4B400" />
            <SolidColorBrush x:Key="PaletteC14" Color="#FF3D5AFE" />
            <SolidColorBrush x:Key="PaletteC15" Color="#FF9C27B0" />
            <SolidColorBrush x:Key="PaletteC16" Color="#FFFF7043" />
            <SolidColorBrush x:Key="PaletteC17" Color="#FFEC407A" />
            <SolidColorBrush x:Key="PaletteC18" Color="#FF66BB6A" />
            <SolidColorBrush x:Key="PaletteC19" Color="#FF26C6DA" />
            <SolidColorBrush x:Key="PaletteC20" Color="#FF8D6E63" />
            <SolidColorBrush x:Key="PaletteC21" Color="#FF90A4AE" />
            <SolidColorBrush x:Key="PaletteC22" Color="#FF000000" />
            <SolidColorBrush x:Key="PaletteC23" Color="#FFFFFFFF" />

            <!-- ============ 通用样式 ============ -->

            <!-- 标题栏按钮（最小化 / 最大化 / 关闭） -->
            <Style x:Key="TitleBarButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgHoverBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 标题栏图标按钮（最小化 / 最大化 / 关闭共用）：常态图标线色跟随「边框色」（IconStrokeBrush，非红）；
                 三者悬停行为完全一致（浅白底 + 满浓度文字色）——统一由本样式承载（OPT-020①）。 -->
            <Style x:Key="TitleBarIconButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
                <Setter Property="Foreground" Value="{DynamicResource IconStrokeBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgHoverBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 关闭按钮 = 标题栏图标按钮（保留独立 key，各窗口现有引用无需改动） -->
            <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button"
                   BasedOn="{StaticResource TitleBarIconButtonStyle}" />

            <!-- 普通按钮 -->
            <Style x:Key="NormalButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource ControlFillBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
                <Setter Property="FontSize" Value="{DynamicResource FontBody}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderWeakBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource RadiusButton}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgHoverBrush}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}" />
                                </Trigger>
                                <!-- 禁用淡出：与 CheckBox / ComboBox 对齐，统一 0.5 -->
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 危险按钮（删除 / 退出） -->
            <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource NormalButtonStyle}">
                <Setter Property="Foreground" Value="{DynamicResource TextDangerBrush}" />
            </Style>

            <!-- 输入框 -->
            <Style x:Key="InputBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="{DynamicResource ControlFillBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderWeakBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
                <Setter Property="FontSize" Value="{DynamicResource FontBody}" />
                <Setter Property="Padding" Value="2,0" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource RadiusInput}">
                                    <!-- 显隐属性必须显式绑定过来：否则在 TextBox 上写
                                     VerticalScrollBarVisibility / HorizontalScrollBarVisibility 不会生效
                                     （之前就是漏了这两个绑定，备注框的滚动条只能靠控件默认值） -->
                                    <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                              HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                    <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}" />
                                    </Trigger>
                                    <!-- 禁用淡出：与 CheckBox / ComboBox 对齐，统一 0.5 -->
                                    <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5" />
                                    </Trigger>
                                    </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 下拉框：收起框体与展开列表均跟随控件填充色 -->
            <Style x:Key="ComboStyle" TargetType="ComboBox">
                <Setter Property="Background" Value="{DynamicResource ControlFillBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderWeakBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
                <Setter Property="FontSize" Value="{DynamicResource FontBody}" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid x:Name="MainGrid" SnapsToDevicePixels="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Border"
                                        Grid.ColumnSpan="2"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{DynamicResource RadiusInput}" />
                                <ToggleButton x:Name="ToggleButton"
                                              Grid.ColumnSpan="2"
                                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              ClickMode="Press">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="ContentSite"
                                                  Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  HorizontalAlignment="Left"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  IsHitTestVisible="False" />
                                <TextBox x:Name="PART_EditableTextBox"
                                         Margin="{TemplateBinding Padding}"
                                         VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                         HorizontalAlignment="Left"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{TemplateBinding Foreground}"
                                         FontFamily="{TemplateBinding FontFamily}"
                                         FontSize="{TemplateBinding FontSize}"
                                         Visibility="Collapsed"
                                         IsReadOnly="{Binding IsReadOnly, RelativeSource={RelativeSource TemplatedParent}}">
                                    <TextBox.Template>
                                        <ControlTemplate TargetType="TextBox">
                                            <Border Background="Transparent">
                                                <ScrollViewer x:Name="PART_ContentHost"
                                                              VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                                              HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}" />
                                            </Border>
                                        </ControlTemplate>
                                    </TextBox.Template>
                                </TextBox>
                                <Path x:Name="Arrow"
                                      Grid.Column="1"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Fill="{DynamicResource TextSecondaryBrush}"
                                      Data="M0,0 L4,4 L8,0 Z" />
                                <Popup x:Name="PART_Popup"
                                       Placement="Bottom"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       PopupAnimation="Slide">
                                    <Border x:Name="PopupBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource RadiusInput}"
                                            MinWidth="{Binding ActualWidth, ElementName=MainGrid}"
                                            MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                        <ScrollViewer>
                                            <ItemsPresenter x:Name="ItemsPresenter"
                                                            KeyboardNavigation.DirectionalNavigation="Contained"
                                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}" />
                                </Trigger>
                                <Trigger Property="IsDropDownOpen" Value="True">
                                    <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}" />
                                </Trigger>
                                <Trigger Property="IsEditable" Value="True">
                                    <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 日程 / 标签编辑用下拉框：在通用 ComboStyle 上统一描边与字号 -->
            <Style x:Key="MaterialCombo" TargetType="ComboBox" BasedOn="{StaticResource ComboStyle}">
                <Setter Property="BorderBrush" Value="{DynamicResource BorderWeakBrush}" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <!-- 下拉项：透明底、跟随主题色，悬停高亮 -->
            <Style TargetType="ComboBoxItem">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
                <Setter Property="FontSize" Value="{DynamicResource FontBody}" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource TextNoteBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 勾选框：背景跟随控件填充色 -->
            <Style TargetType="CheckBox">
                <Setter Property="Background" Value="{DynamicResource ControlFillBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderWeakBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
                <Setter Property="FontSize" Value="{DynamicResource FontBody}" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Box"
                                        Width="16" Height="16"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="3">
                                    <Path x:Name="CheckMark"
                                          Width="10" Height="10"
                                          Data="M1,5 L4,8 L9,1"
                                          Stroke="{DynamicResource TextPrimaryBrush}"
                                          StrokeThickness="2"
                                          Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter x:Name="Content"
                                                  Grid.Column="1"
                                                  Margin="6,0,0,0"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  HorizontalAlignment="Left"
                                                  RecognizesAccessKey="True" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                                    <!-- 打钩态改为「浅白底 + 系统边框色边」（OPT-018）：
                                         不再用固定主按钮蓝，改复用普通按钮悬停的浅白路径，与普通按钮体系一致 -->
                                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource BgHoverBrush}" />
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BorderWeakBrush}" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 分组标题（设置窗） -->
            <Style x:Key="GroupTitleStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
                <Setter Property="FontSize" Value="{DynamicResource FontBody}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Height" Value="22" />
                <Setter Property="Margin" Value="0,8,0,0" />
            </Style>

            <!-- 设置项标签 -->
            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
                <Setter Property="FontSize" Value="{DynamicResource FontBody}" />
                <Setter Property="Height" Value="20" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- 辅助说明文字 -->
            <Style x:Key="HintTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextNoteBrush}" />
                <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
                <Setter Property="FontSize" Value="{DynamicResource FontCaption}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,4,0,0" />
            </Style>

            <!-- 分组分隔线 -->
            <Style x:Key="GroupSeparatorStyle" TargetType="Rectangle">
                <Setter Property="Height" Value="1" />
                <Setter Property="Opacity" Value="0.4" />
                <Setter Property="Fill" Value="{DynamicResource BorderWeakBrush}" />
                <Setter Property="Margin" Value="0,6,0,6" />
            </Style>

            <!-- ==================== 滚动条（全局统一配色，轻量版） ====================
                 只重画「轨道 + 滑块」，去掉了两端的小箭头按钮（现代细条样式）：
                 滚轮、拖动滑块、点击轨道翻页三种操作都保留。
                 颜色全部走程序现有主题：轨道 = 控件填充色，滑块 = 浅白悬停层，悬停/拖动 = 焦点边框色。
                 隐式样式（不写 x:Key）放在应用级资源里 → 程序内所有滚动条自动套用，
                 包括控件模板内部的（设置窗列表、编辑窗表格、备注输入框、下拉列表等）。
                 注：Windows 系统自己的文件选择对话框不受影响（那是系统画的）。 -->

            <!-- 轨道空白区：透明，只负责"点击翻页" -->
            <Style x:Key="ScrollBarPageButtonStyle" TargetType="RepeatButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border Background="Transparent" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 滑块 -->
            <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
                <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border x:Name="Bd" Margin="2"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="3" />
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FocusBorderBrush}" />
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FocusBorderBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ScrollBar">
                <Setter Property="Background" Value="{DynamicResource ControlFillBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Width" Value="12" />
                <Setter Property="MinWidth" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Border Background="{TemplateBinding Background}" CornerRadius="3"
                                    SnapsToDevicePixels="True">
                                <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                      Style="{StaticResource ScrollBarPageButtonStyle}" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollBarThumbStyle}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                      Style="{StaticResource ScrollBarPageButtonStyle}" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <!-- 横向滚动条：同样的配色，只是方向不同 -->
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Width" Value="Auto" />
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="Height" Value="12" />
                        <Setter Property="MinHeight" Value="12" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="3"
                                            SnapsToDevicePixels="True">
                                        <Track x:Name="PART_Track" IsDirectionReversed="False" Focusable="False">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}"
                                                              Style="{StaticResource ScrollBarPageButtonStyle}" />
                                            </Track.DecreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb Style="{StaticResource ScrollBarThumbStyle}" />
                                            </Track.Thumb>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}"
                                                              Style="{StaticResource ScrollBarPageButtonStyle}" />
                                            </Track.IncreaseRepeatButton>
                                        </Track>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 滑块（简易样式，保证暗色下可见） -->
            <Style x:Key="SliderStyle" TargetType="Slider">
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Minimum" Value="0" />
                <Setter Property="Maximum" Value="100" />
                <Setter Property="Height" Value="28" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- 日程完成勾选框：勾色由 Tag 传入（日程背景反色），编辑窗与待办面板共用 -->
            <Style x:Key="ScheduleCheckBoxStyle" TargetType="CheckBox">
                <Setter Property="Width" Value="16" />
                <Setter Property="Height" Value="16" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid Width="16" Height="16">
                                <!-- 悬停底色：由 CheckBox.Background 绑定当前日程反色块（Tag 仍是勾/框实色） -->
                                <Border x:Name="HoverBg" CornerRadius="3"
                                        Background="{TemplateBinding Background}"
                                        Opacity="0" />
                                <Border x:Name="Box" CornerRadius="3"
                                        Background="Transparent"
                                        BorderBrush="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                        BorderThickness="1"
                                        SnapsToDevicePixels="True" />
                                <Path x:Name="Check" Data="M3 8 L6.5 11.5 L13 4.5"
                                      Stroke="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="Collapsed" SnapsToDevicePixels="True" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="HoverBg" Property="Opacity" Value="0.5" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="HoverBg" Property="Opacity" Value="1" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
